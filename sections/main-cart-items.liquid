                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>

        {%- if cart != empty -%}
          <div class="cart-right col-lg-4">
            <div class="left-checkout top-30">
              {%- if eb_cart_note -%}
                
              {%- endif -%}
              
             


