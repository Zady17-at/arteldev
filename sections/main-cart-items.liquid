<script>
  document.addEventListener('DOMContentLoaded', function() {
    const radios = document.querySelectorAll('input[name="gift_wrap_option"]');
    const giftWrapper = document.getElementById('gift-note-wrapper');

    radios.forEach(radio => {
      radio.addEventListener('change', function() {
        if(this.value === 'yes') {
          giftWrapper.style.display = 'block';
        } else {
          giftWrapper.style.display = 'none';
          document.getElementById('gift_note').value = ''; // clear note
        }
      });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
  const radios = document.querySelectorAll('input[name="gift_wrap_option"]');
  const noteWrapper = document.querySelector('#gift-note-wrapper');

  radios.forEach(radio => {
    radio.addEventListener('change', function() {
      if (this.value === 'yes') {
        noteWrapper.style.display = 'block';
      } else {
        noteWrapper.style.display = 'none';
      }
    });
  });
});
{% comment %} document.addEventListener('DOMContentLoaded', function () {
  const checkoutBtn = document.querySelector('#checkout');
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', function(e) {
      e.preventDefault();
      window.location.href = '/checkout';
    });
  }
}); {% endcomment %}
function handleGiftOption(wrapper = document) {
  const radios = wrapper.querySelectorAll('input[name="gift_wrap_option"]');
  const giftWrapper = wrapper.querySelector('#gift-note-wrapper');

  if (!giftWrapper || radios.length === 0) return;

  radios.forEach(radio => {
    radio.addEventListener('change', function() {
      if (this.value === 'yes') {
        giftWrapper.style.display = 'block';
      } else {
        giftWrapper.style.display = 'none';
        const noteField = giftWrapper.querySelector('#gift_note');
        if (noteField) noteField.value = '';
      }
    });

    // Set initial state
    if (radio.checked && radio.value === 'yes') {
      giftWrapper.style.display = 'block';
    } else if (radio.checked && radio.value === 'no') {
      giftWrapper.style.display = 'none';
    }
  });
}

// Run on page load
document.addEventListener('DOMContentLoaded', () => {
  handleGiftOption();
});

// Listen for cart AJAX updates (Shopify themes often dispatch this custom event)
document.addEventListener('cart:updated', () => {
  // Re-attach handlers for new cart HTML
  handleGiftOption(document);
});

// If your theme uses a custom AJAX fetch without dispatching cart:updated,
// you can also use MutationObserver to watch cart container for changes:
const cartContainer = document.getElementById('main-cart-items');
if (cartContainer) {
  const observer = new MutationObserver(() => handleGiftOption(cartContainer));
  observer.observe(cartContainer, { childList: true, subtree: true });
}

</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const textarea = document.querySelector("#gift_note");
  const radios = document.querySelectorAll('input[name="gift_wrap_option"]');

  if (!textarea) return;

  // Save gift message to cart attributes
 function saveGiftMessage() {
  const selectedGift = document.querySelector('input[name="gift_wrap_option"]:checked')?.value || "no";
  const note = textarea.value.trim();
  let finalNote = "";

  if (selectedGift === "yes") {
    if (note !== "") {
      finalNote = note; // user wrote a message
    } else {
      finalNote = "Gift wrap: YES"; // no message, but gift wrap selected
    }
  } else {
    finalNote = ""; // gift = no → clear attribute
  }

  fetch("/cart/update.js", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      attributes: {
        gift_note: finalNote
      }
    })
  });
}

  // Save note whenever user types (debounced)
  let typingTimer;
  textarea.addEventListener("input", () => {
    clearTimeout(typingTimer);
    typingTimer = setTimeout(saveGiftMessage, 300);
  });

  // Save when user selects YES/NO
  radios.forEach(radio => {
    radio.addEventListener("change", saveGiftMessage);
  });

  // Save again before redirecting to checkout
  const checkoutBtn = document.querySelector("#checkout");
  if (checkoutBtn) {
    checkoutBtn.addEventListener("click", function (e) {
      e.preventDefault();
      saveGiftMessage(); // ensures last state saved
      setTimeout(() => { window.location.href = "/checkout"; }, 200);
    });
  }
});
</script>


