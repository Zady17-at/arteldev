{% liquid
  assign sec_settings = section.settings
  assign gift_wrap_pr = all_products[sec_settings.product_gift_cart]
  assign gift_pr_id = gift_wrap_pr.id
  assign gift_wrap = cart.items | where: 'product_id', gift_pr_id
  if settings.currency_code_enabled
    assign gift_pr_price = gift_wrap_pr.selected_or_first_available_variant.price | money_with_currency
  else
    assign gift_pr_price = gift_wrap_pr.selected_or_first_available_variant.price | money
  endif

  assign section_width = ''
  if sec_settings.section_width == 'fix_width'
    assign section_width = ' container'
  elsif sec_settings.section_width == 'expand_full_width'
    assign section_width = ' full-width px-20'
  else
    assign section_width = ' full-width-gap'
  endif

  assign eb_cart_note = sec_settings.eb_cart_note
  assign eb_gift_wrap = sec_settings.eb_gift_wrap
%}
{%- capture style -%}
  --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}
{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<div
  class="page-cart section-padding {% if cart == empty %} is-empty{% endif %}"
  id="main-cart-items"
  data-id="{{ section.id }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div class="js-contents{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% if cart != empty %}
        <div class="page-title text-center mb-80">
          <div class="breadcrumbs mb-10 justify-content-left">
            {%- render 'breadcrumbs' -%}
          </div>
          <h1 class="heading-letter-spacing title title--primary h0 text-center">Shopping Bag</h1>
        </div>
      {% endif %}
      <div class="main-cart">
        <div class="{% if cart != empty %}col-lg-8 mb-60 mb-lg-0{% else %} col-12 {% endif %} cart-left">
          <div class="sticky top-30">
            <cart-items class="{% if cart == empty %}is-empty{% endif %}">
              {% if cart == empty %}
                <div class="cart__warnings text-center">
                  {% comment %} <h1 class="heading-letter-spacing cart__empty-title">{{ 'sections.cart.empty' | t }}</h1> {% endcomment %}
                  <a href="{{ routes.all_products_collection_url }}" class="button">
                    {{ 'general.continue_shopping' | t }}
                  </a>
                </div>
              {% endif %}
              {%- if cart != empty -%}
                <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
                  <div class="cart__items pb-15 border-bottom">
                    <div class="cart-items">
                      <table class="cart-table w-full border-collapse">
                        <thead>
                          <tr>
                            <th class="col-image text-left">Product</th>
                            <th class="col-quantity text-center opacity-0">Details</th>
                            <th class="col-quantity text-center">Quantity</th>
                            <th class="col-price-item text-right">Unit price</th>
                            <th class="col-price text-right">Total</th>
                          </tr>
                        </thead>
                        <tbody>
                        {%- for item in cart.items -%}
                          <tr class="cart-item product__item border-bottom pb-15 mb-15 last-0" id="CartItem-{{ item.index | plus: 1 }}">
                            <!-- Product Image -->
                            <td class="cart-item__media text-left">
                              {% if item.image %}
                                {%- liquid
                                  assign ratio = ''
                                  if settings.product_image_ratio != 'adapt_to_image'
                                    case settings.product_image_ratio
                                      when 'square'
                                        assign ratio = '1/1'
                                      else
                                        assign ratio = '3/4'
                                    endcase
                                  else
                                    assign ratio = item.image.aspect_ratio
                                  endif
                                -%}
                                <div class="banner__media" style="--aspect-ratio: {{ ratio }}">
                                  <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true">
                                    <img class="cart-item__image" src="{{ item.image | image_url: width: 300 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="150" height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}">
                                  </a>
                                </div>
                              {% endif %}
                            </td>

                        <td class="cart-item__info flex-1 d-flex flex-column justify-between">
  <div>
    <!-- Product Name -->
    <a href="{{ item.url }}" class="remove-underline border-animation product__name heading-style lh-1">
      {{ item.product.title | escape }}
    </a>

    <!-- Extended Shape Name or Variant Fallback -->
    {% if item.product.metafields.custom.extended_shape_name and item.product.metafields.custom.extended_shape_name != '' %}
      <p class="extended-shape mt-1">{{ item.product.metafields.custom.extended_shape_name }}</p>
    {% else %}
      <p class="variant-shape mt-1">{{ item.variant.option3 }}</p>
    {% endif %}

    <!-- Color + SKU only -->
    <div class="product_option-cart mt-2">
      {% comment %} Only show Color if it exists {% endcomment %}
      {% assign color_option = item.variant.option1 %}
      {% if color_option %}
        <div class="product-option d-inline-flex pr-3 ">
          <b>Color </b>: {{ color_option }}
        </div>
      {% endif %}

      <!-- SKU -->
      {% if item.variant.sku != blank %}
        <div class="product-option d-inline-flex pr-3">
          <b>Product code </b>: {{ item.variant.sku }}
        </div>
      {% endif %}
    </div>
  </div>
</td>





                            <!-- Quantity -->
                            <td class="cart-item__quantity-wrapper text-center">
                              <quantity-input class="quantity cart-quantity align-center d-inline-flex rounded-10 p-0!" style="--input-height: 35px">
                                <button class="button quantity__button" name="minus" type="button">
                                  <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                                  {% render 'icon-minus', custom_width: 12 %}
                                </button>
                                <input
                                  class="quantity__input text-center w-38"
                                  type="number"
                                  name="updates[]"
                                  value="{{ item.quantity }}"
                                  data-quantity-variant-id="{{ item.variant.id }}"
                                  min="{{ item.variant.quantity_rule.min }}"
                                  {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                                  step="{{ item.variant.quantity_rule.increment }}"
                                  aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                  id="Quantity-{{ item.index | plus: 1 }}"
                                  data-index="{{ item.index | plus: 1 }}"
                                >
                                <button class="button quantity__button" name="plus" type="button">
                                  <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                                  {% render 'icon-plus', custom_width: 12 %}
                                </button>
                              </quantity-input>

                              <cart-remove-button id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                                <a href="{{ item.url_to_remove }}" class="button button--tertiary fs-small ml-10 btn-remove-cart-item">
                                  {{ 'sections.cart.remove_title' | t }}
                                </a>
                              </cart-remove-button>
                            </td>

                            <!-- Unit Price -->
                            <td class="cart-item__unit-price text-right">
                              {%- if item.variant.available and item.unit_price_measurement -%}
                                <div class="unit-price caption">
                                  {{ item.variant.unit_price | money }} /
                                  {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                                    {{ item.variant.unit_price_measurement.reference_value }}
                                  {%- endif -%}
                                  {{ item.variant.unit_price_measurement.reference_unit }}
                                </div>
                              {%- else -%}
                                <div>{{ item.original_price | money }}</div>
                              {%- endif -%}
                            </td>

                            <!-- Total Price -->
                            <td class="cart-item__total text-right">
                              {%- if item.original_line_price != item.final_line_price -%}
                                <div class="cart-item__discounted-prices">
                                  <s class="cart-item__old-price price price--end">{{ item.original_line_price | money }}</s>
                                  <span class="price price--end">{{ item.final_line_price | money }}</span>
                                </div>
                              {%- else -%}
                                <span class="price price--end">{{ item.original_line_price | money }}</span>
                              {%- endif -%}
                            </td>
                          </tr>
                        {%- endfor -%}
                        </tbody>
                      </table>
                    </div>
                  </div>

                  <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
                  <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
                    {{ 'accessibility.loading' | t }}
                  </p>
                </form>
              {%- endif -%}
              
            </cart-items>
            
  {%- if cart != empty and section.settings.eb_gift_wrap and gift_wrap_pr -%}
<div class="cart-gift-option mt-20 mb-30">
