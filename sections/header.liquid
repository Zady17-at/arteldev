{%- liquid
  assign section_st = section.settings
  assign transparent_on_home = ''
  assign section_width = ''
  if section_st.section_width == 'fix_width'
    assign section_width = 'container'
  elsif section_st.section_width == 'expand_full_width'
    assign section_width = 'full-width px-20'
  else
    assign section_width = 'full-width-gap'
  endif
  assign transparent_mobile_class = ''
  if section_st.transparent_on_home and section_st.transparent_on_home
    assign transparent_mobile_class = ' transparent-mobile '
  endif
-%}
<script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
{%- if settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if settings.cart_type == 'added_message' -%}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section_st.transparent_on_home -%}
  {%- assign transparent_on_home = ' transparent transition' -%}
{%- endif -%}
{%- capture style -%}
  {%- if section_st.uppercase_first_level -%}
    --menu-parent-text-transform: uppercase;
  {%- endif -%}
  {%- if section_st.header_text_icon_transparent != blank -%} 
    --header-transparent-color: {{ section_st.header_text_icon_transparent.red }}, {{ section_st.header_text_icon_transparent.green }}, {{ section_st.header_text_icon_transparent.blue }};
  {%- endif -%}
  --logo-width: {{ section_st.logo_width }}px; --logo-position: {{ section_st.logo_position }}; --logo-mobile-width: {{ section_st.logo_width_mobile }}px
{%- endcapture -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{% if section_st.sticky_header_type != 'none' -%}
  <sticky-header data-sticky-type="{{ section_st.sticky_header_type }}" class="header-wrapper">
{% else %}
  <div class="header-wrapper">
{% endif %}
<header
  class="color-{{ section_st.color_scheme }} gradient bls_header relative z-4{{ transparent_on_home }}{{ transparent_mobile_class }}{% if section_st.show_border_bottom and section_st.transparent_on_home %} {% if section_st.logo_position != 'menu-left' %}border-bottom{% endif %}{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <header-inner class="d-grid align-center logo-{{ section_st.logo_position }}{% if section_st.logo_position == 'menu-left' %} logo-left border-bottom{% endif %}{% if section_st.show_border_bottom and section_st.transparent_on_home == blank %} border-bottom{% endif %}">
      <div class="header__logo text-center{% if section_st.logo_position != 'center' %} text-1025-unset{% endif %}">
        {% if request.page_type == 'index' %}
          <h1
            class="my-0{% if settings.heading_letter_spacing == '0.25em' %} fs-24{% else %} fs-40{% endif %} lh-normal heading-letter-spacing"
          >
        {% else %}
          <div
            class="h1 my-0{% if settings.heading_letter_spacing == '0.25em' %} fs-24{% else %} fs-40{% endif %} lh-normal heading-letter-spacing"
          >
        {%- endif -%}
        <a
          href="{{ routes.root_url }}"
          class="text-center header__heading-link link link--text remove-underline header-color heading-style"
          aria-label="{{ shop.name }}"
        >
          {%- liquid
            assign logo_img = ''
            assign logo_transparent_img = ''
            assign logo_img = section_st.logo
            assign logo_transparent_img = section_st.logo_transparent
          -%}
          {% if section_st.transparent_on_home and section_st.logo_transparent != blank %}
            {%- liquid
              assign img_transparent_alt = logo_transparent_img.alt | default: shop.name | escape
              assign logo_height = logo_transparent_img.width | divided_by: logo_transparent_img.aspect_ratio
            -%}
            {{
              logo_transparent_img
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo transparent-logo',
                widths: '50, 100, 150, 200, 250, 300, 400, 500, 600',
                height: logo_height,
                width: logo_transparent_img.width,
                alt: img_transparent_alt,
                sizes: '100vw',
                fetchpriority: 'high'
            }}
          {% endif %}
          {%- if logo_img != blank -%}
            {%- assign img_alt = logo_img.alt | default: shop.name | escape -%}
            {%- assign logo_height = logo_img.width | divided_by: logo_img.aspect_ratio -%}
            {{
              logo_img
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo',
                widths: '50, 100, 150, 200, 250, 300, 400, 500, 600',
                height: logo_height,
                width: logo_img.width,
                alt: img_alt,
                sizes: '100vw',
                fetchpriority: 'high'
            }}
          {%- else -%}
            <span class="site-logo">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {% if request.page_type == 'index' %}
          </h1>
        {% else %}
          </div>
        {%- endif -%}
      </div>
      {%- if section_st.menu != blank -%}
        <nav class="header__menu overlay-menu overlay-section">
          {% render 'horizontal-menu', menu_handle: 'primary-menu-testing' %}

      


          {% comment %} <toggle-menu data-item="overlay-menu" class="hidden-no-js mobile-menu-toggle">
            
            <button
              class="relative touch-target button btn-reset flex-column btn-close-menu"
              aria-haspopup="dialog"
              aria-label="{{ 'sections.header.expand_menu' | t }}"
              id="menu-bar-icon-bubble"
            >
              <span class="icon-menu first"></span>
              <span class="icon-menu second hidden"></span>
              <span class="icon-menu last"></span>
              <span class="absolute inset-0 opacity-0 icon-close z-1 d-inline-flex align-center justify-content-center">
                {% render 'icon-close', custom_width: 22 %}
              </span>
            </button>
          </toggle-menu> {% endcomment %}
          <input
            class="absolute inset-y-0 opacity-0 d-block d-1025-none side-menu hidden-js touch-target"
            type="checkbox"
            id="side-menu"
          >
          <label class="relative d-block d-1025-none hamb hidden-js btn-close-menu" for="side-menu">
            <span class="my-3 icon-menu first d-block"></span>
            <span class="my-3 icon-menu second d-block"></span>
            <span class="my-3 icon-menu last d-block"></span>
            <span class="absolute inset-0 opacity-0 icon-close z-1 d-inline-flex align-center justify-content-center">
              {% render 'icon-close', custom_width: 22 %}
            </span>
            <span class="visually-hidden">{{ 'sections.header.expand_menu' | t }}</span>
          </label>
        </nav>
      {%- endif -%}
      {%- if section_st.show_account
        or section_st.show_search
        or section_st.show_cart
        or section_st.show_language
        or section_st.show_currency
      -%}
        <div class="header__action d-flex align-center justify-content-end">
          {% if section_st.show_language or section_st.show_currency %}
            <div class="desktop-localization-wrapper last-r-0 pl-10 d-none d-1025-flex align-center gap-15 pr-30 header-color{% if settings.menu_font == 'heading_font' %} use-heading-font{% endif %}">
              {% if section_st.show_currency %}
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              {% endif %}
              {% if section_st.show_language %}
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              {% endif %}
            </div>
          {% endif %}
          {%- if section_st.show_search -%}
            <a
              href="{{ routes.search_url }}"
              class="mx-3 header__icon header__icon--search link focus-inset tooltip last-r-0 element-focus"
              id="search-icon-bubble"
              data-custom-class="{{ section_width }}"
            >
              <span class="tooltip-content fs-small tooltip-bottom">
                {{ 'general.search.search' | t }}
              </span>
              {% render 'icon-search', custom_width: 22 %}

              <span class="visually-hidden">{{ 'general.search.search' | t }}</span>
            </a>
          {%- endif -%}
          {%- if section_st.show_account -%}
            <a
              href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
              class="mx-3 header__icon header-account link tooltip last-r-0 d-none d-1025-inline-flex"
              aria-label="{{ 'customer.account_fallback' | t }}"
            >
              {% render 'icon-account', custom_width: 25 %}
              <span class="tooltip-content fs-small tooltip-bottom">
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </span>
            </a>
          {%- endif -%}
          {%- if section_st.show_cart -%}
            <a href="/cart" class="ai-header-icon-item-avzfbszvxdwz2njdvvaigenblock87fb302hf44vm cart-drawer-toggle" id="cart-icon-bubble" data-cart-drawer="">
  <svg class="ai-header-icon-avzfbszvxdwz2njdvvaigenblock87fb302hf44vm" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119.993z"></path>
  </svg>

  <div class="ai-header-icon-text-avzfbszvxdwz2njdvvaigenblock87fb302hf44vm">
    <span class="ai-header-icon-label-avzfbszvxdwz2njdvvaigenblock87fb302hf44vm">
      Shopping Bag
    </span>
    <span class="ai-header-icon-count-avzfbszvxdwz2njdvvaigenblock87fb302hf44vm">
      {{ cart.item_count }} {% if cart.item_count == 1 %}Item{% else %}Items{% endif %}
    </span>
  </div>
</a>

          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if settings.cart_type == 'added_message' -%}
        {%- render 'cart-notification' -%}
      {%- endif -%}
    </header-inner>
  </div>
</header>
{% if section_st.sticky_header_type != 'none' %}</sticky-header>{% else %}</div>{% endif %}
{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section_st.logo %}
      "logo": {{ section_st.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_media_twitter | json }},
      {{ settings.social_media_facebook | json }},
      {{ settings.social_media_instagram | json }},
      {{ settings.social_media_tiktok | json }},
      {{ settings.social_media_pinterest | json }},
      {{ settings.social_media_youtube | json }},
      {{ settings.social_media_vimeo | json }},
      {{ settings.social_media_linkedin | json }},
      {{ settings.social_media_whatsapp | json }},
      {{ settings.social_media_snapchat | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>
{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "fix_width",
          "label": "t:sections.all.layout.fix_width"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.layout.stretch_width"
        },
        {
          "value": "expand_full_width",
          "label": "t:sections.all.layout.expand_full_width"
        }
      ],
      "default": "stretch_width",
      "label": "t:sections.all.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.header.settings.logo_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.header.settings.logo_position.options__2.label"
        },
        {
          "value": "menu-left",
          "label": "t:sections.header.settings.logo_position.options__3.label"
        }
      ],
      "default": "left",
      "info": "t:sections.header.settings.logo_position.info",
      "label": "t:sections.header.settings.logo_position.label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
