            {%- endfor -%}
            <div class="facet-remove facet-clear-all btn-text-transform fs-small d-inline-flex align-center heading-color lh-reset py-10 px-15 mt-10 mt-1025-0">
              <facet-remove class="active-facets__button-wrapper">
