{% doc %}
  @prompt
    FUll width section with 2 columns , 1 should have video and other has text  , also their should be full customization options of styling and alignements also for resposnsisve video addition option with url, should be able to add by both ways , manually and by url as well and supports all the cutsimizations of styling, shoild be full width section

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-text-section-{{ ai_gen_id }} {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-text-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  .ai-video-text-video-column-{{ ai_gen_id }} {
    {% if block.settings.layout == 'text_left' %}
      order: 2;
    {% else %}
      order: 1;
    {% endif %}
  }

  .ai-video-text-text-column-{{ ai_gen_id }} {
    {% if block.settings.layout == 'text_left' %}
      order: 1;
    {% else %}
      order: 2;
    {% endif %}
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.text_color }};
  }

  .ai-video-text-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
    box-shadow: {{ block.settings.video_shadow_horizontal }}px {{ block.settings.video_shadow_vertical }}px {{ block.settings.video_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.video_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-video-text-video-wrapper-{{ ai_gen_id }} iframe,
  .ai-video-text-video-wrapper-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .ai-video-text-aspect-ratio-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.video_aspect_ratio }}%;
  }

  .ai-video-text-aspect-ratio-{{ ai_gen_id }} iframe,
  .ai-video-text-aspect-ratio-{{ ai_gen_id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-video-text-placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.video_border_radius }}px;
    position: relative;
  }

  .ai-video-text-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.5;
  }

  .ai-video-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .ai-video-text-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px;
    line-height: {{ block.settings.heading_line_height }};
    font-weight: {{ block.settings.heading_font_weight }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-video-text-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
    margin: 0 0 {{ block.settings.text_margin }}px;
    font-weight: {{ block.settings.text_font_weight }};
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
  }

  .ai-video-text-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};box-shadow: {{ block.settings.button_shadow_horizontal }}px {{ block.settings.button_shadow_vertical }}px {{ block.settings.button_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.button_shadow_opacity | divided_by: 100.0 }});
    text-transform: {{ block.settings.button_text_transform }};
  }

  .ai-video-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY({{ block.settings.button_hover_transform }}px);
    box-shadow: {{ block.settings.button_hover_shadow_horizontal }}px {{ block.settings.button_hover_shadow_vertical }}px {{ block.settings.button_hover_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.button_hover_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-video-text-video-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient({{ block.settings.video_overlay_direction }}deg, {{ block.settings.video_overlay_color_1 }} 0%, {{ block.settings.video_overlay_color_2 }} 100%);
    opacity: {{ block.settings.video_overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }

  {% if block.settings.full_width_background %}
    .ai-video-text-full-bg-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: {{ block.settings.background_color }};
      z-index: -1;
    }
  {% endif %}

  @media screen and (max-width: 768px) {
    .ai-video-text-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-video-text-video-column-{{ ai_gen_id }},
    .ai-video-text-text-column-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'video_first' %}
        order: unset;
      {% elsif block.settings.mobile_layout == 'text_first' %}
        order: unset;
      {% endif %}
    }

    {% if block.settings.mobile_layout == 'text_first' %}
      .ai-video-text-video-column-{{ ai_gen_id }} {
        order: 2;
      }
      .ai-video-text-text-column-{{ ai_gen_id }} {
        order: 1;
      }
    {% endif %}

    .ai-video-text-text-column-{{ ai_gen_id }} {
      text-align: {{ block.settings.mobile_text_alignment }};
    }

    .ai-video-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
      margin-bottom: {{ block.settings.mobile_heading_margin }}px;
    }

    .ai-video-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
      margin-bottom: {{ block.settings.mobile_text_margin }}px;
    }

    .ai-video-text-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding_top }}px 0 {{ block.settings.mobile_section_padding_bottom }}px;
    }

    .ai-video-text-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_text_size }}px;
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
    }

    .ai-video-text-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-video-text-container-{{ ai_gen_id }} {
      padding: 0 10px;
    }
  }
{% endstyle %}

<video-text-section-{{ ai_gen_id }} class="ai-video-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.full_width_background %}
    <div class="ai-video-text-full-bg-{{ ai_gen_id }}"></div>
  {% endif %}
  
  <div class="ai-video-text-container-{{ ai_gen_id }}">
    <div class="ai-video-text-grid-{{ ai_gen_id }}">
      <div class="ai-video-text-video-column-{{ ai_gen_id }}">
        {% assign has_video = false %}
        
        {% if block.settings.video_file != blank %}
          {% assign has_video = true %}
          <div class="ai-video-text-video-wrapper-{{ ai_gen_id }}">
            {% if block.settings.enable_video_overlay %}
              <div class="ai-video-text-video-overlay-{{ ai_gen_id }}"></div>
            {% endif %}
            <div class="ai-video-text-aspect-ratio-{{ ai_gen_id }}">
              <video 
                {% if block.settings.video_autoplay %}autoplay{% endif %}
                {% if block.settings.video_muted %}muted{% endif %}
                {% if block.settings.video_loop %}loop{% endif %}
                {% if block.settings.video_controls %}controls{% endif %}
                preload="metadata"
                playsinline
              >
                <source src="{{ block.settings.video_file }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            </div>
          </div>
        {% elsif block.settings.video_url != blank %}
          {% assign has_video = true %}
          <div class="ai-video-text-video-wrapper-{{ ai_gen_id }}">
            {% if block.settings.enable_video_overlay %}
              <div class="ai-video-text-video-overlay-{{ ai_gen_id }}"></div>
            {% endif %}
            <div class="ai-video-text-aspect-ratio-{{ ai_gen_id }}">
              {% assign video_id = '' %}
              {% if block.settings.video_url contains 'youtube.com/watch' %}
                {% assign video_id = block.settings.video_url | split: 'v=' | last | split: '&' | first %}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_id }}?rel=0&modestbranding=1{% if block.settings.video_autoplay %}&autoplay=1{% endif %}{% if block.settings.video_muted %}&mute=1{% endif %}{% if block.settings.video_loop %}&loop=1&playlist={{ video_id }}{% endif %}{% unless block.settings.video_controls %}&controls=0{% endunless %}"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% elsif block.settings.video_url contains 'youtu.be/' %}
                {% assign video_id = block.settings.video_url | split: 'youtu.be/' | last | split: '?' | first %}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_id }}?rel=0&modestbranding=1{% if block.settings.video_autoplay %}&autoplay=1{% endif %}{% if block.settings.video_muted %}&mute=1{% endif %}{% if block.settings.video_loop %}&loop=1&playlist={{ video_id }}{% endif %}{% unless block.settings.video_controls %}&controls=0{% endunless %}"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% elsif block.settings.video_url contains 'vimeo.com' %}
                {% assign video_id = block.settings.video_url | split: 'vimeo.com/' | last | split: '/' | first %}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_id }}?title=0&byline=0&portrait=0{% if block.settings.video_autoplay %}&autoplay=1{% endif %}{% if block.settings.video_muted %}&muted=1{% endif %}{% if block.settings.video_loop %}&loop=1{% endif %}"
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {% else %}
                <video 
                  {% if block.settings.video_autoplay %}autoplay{% endif %}
                  {% if block.settings.video_muted %}muted{% endif %}
                  {% if block.settings.video_loop %}loop{% endif %}
                  {% if block.settings.video_controls %}controls{% endif %}
                  preload="metadata"
                  playsinline
                >
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% unless has_video %}
          <div class="ai-video-text-placeholder-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5,3 19,12 5,21"></polygon>
            </svg>
            <div class="ai-video-text-empty-state-{{ ai_gen_id }}">
              Add a video file or URL to get started
            </div>
          </div>
        {% endunless %}
      </div>

      <div class="ai-video-text-text-column-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text_content != blank %}
          <div class="ai-video-text-content-{{ ai_gen_id }}">{{ block.settings.text_content }}</div>
        {% endif %}

        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-video-text-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</video-text-section-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoTextSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupResponsiveVideo();
        this.setupVideoInteractions();
      }

      setupResponsiveVideo() {
        const videoWrapper = this.querySelector('.ai-video-text-video-wrapper-{{ ai_gen_id }}');
        if (!videoWrapper) return;

        const iframe = videoWrapper.querySelector('iframe');
        const video = videoWrapper.querySelector('video');
        
        if (iframe || video) {
          this.handleResize();
          window.addEventListener('resize', () => this.handleResize());
        }
      }

      setupVideoInteractions() {
        const video = this.querySelector('video');
        if (video) {
          video.addEventListener('loadedmetadata', () => {
            this.handleResize();
          });

          video.addEventListener('error', (e) => {
            console.warn('Video failed to load:', e);
            this.showVideoError();
          });
        }
      }

      handleResize() {
        const videoElement = this.querySelector('iframe, video');
        if (videoElement) {
          const container = videoElement.closest('.ai-video-text-aspect-ratio-{{ ai_gen_id }}');
          if (container) {
            const containerWidth = container.offsetWidth;
            const aspectRatio = {{ block.settings.video_aspect_ratio }} / 100;
            const height = containerWidth * aspectRatio;
            container.style.height = height + 'px';
          }
        }
      }

      showVideoError() {
        const videoWrapper = this.querySelector('.ai-video-text-video-wrapper-{{ ai_gen_id }}');
        if (videoWrapper) {
          videoWrapper.innerHTML = `
            <div class="ai-video-text-placeholder-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
              <div class="ai-video-text-empty-state-{{ ai_gen_id }}">
                Video failed to load. Please check the file or URL.
              </div>
            </div>
          `;
        }
      }
    }

    customElements.define('video-text-section-{{ ai_gen_id }}', VideoTextSection{{ ai_gen_id }});
  })();
</script>

