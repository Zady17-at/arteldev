<script>
  // --- Wishlist Count Update ---
  window.SwymCallbacks = window.SwymCallbacks || [];
  window.SwymCallbacks.push(function (swat) {
    function updateWishlistCount() {
      swat.fetch(function (products) {
        var count = products.length;
        var badge = document.querySelector('.ai-header-icon-count-{{ ai_gen_id }} .swym-anchor-badge');
        var label = document.querySelector('.ai-header-icon-count-{{ ai_gen_id }} .swym-wishlist-count-label');
        if (badge) {
          if (count > 0) {
            badge.textContent = count;
            badge.setAttribute("data-count", count);
            badge.style.display = "inline-block";
          } else {
            badge.textContent = "";
            badge.setAttribute("data-count", 0);
            badge.style.display = "none";
          }
        }
        if (label) {
          label.textContent = count === 1 ? "Item" : (count > 1 ? "Items" : "");
        }
      });
    }
    updateWishlistCount();
    document.addEventListener("swym:collections-update", updateWishlistCount);
    document.addEventListener("swym:product-added", updateWishlistCount);
    document.addEventListener("swym:product-removed", updateWishlistCount);
  });

  // --- Cart Count Update + Layout Preservation ---
  function updateCartCount() {
    fetch("/cart.js")
      .then((res) => res.json())
      .then((cart) => {
        const cartCountEl = document.querySelector(
          "#cart-icon-bubble .ai-header-icon-count-{{ ai_gen_id }}"
        );
        if (cartCountEl) {
          cartCountEl.textContent =
            cart.item_count +
            (cart.item_count === 1 ? " Item" : " Items");
        }
      });
  }

  // Run once on page load
  updateCartCount();

  // Watch for cart updates (drawer or AJAX)
  document.addEventListener("cart:updated", updateCartCount);
  document.addEventListener("cart:refresh", updateCartCount);

  // --- Fallback MutationObserver to catch theme replacements ---
const observer = new MutationObserver(() => {
  const cartIcon = document.getElementById("cart-icon-bubble");
  if (cartIcon && !cartIcon.querySelector(".ai-header-icon-text-{{ ai_gen_id }}")) {
    // Rebuild the SVG + text + count
    cartIcon.innerHTML = `
      <span class="header__icon">
        {% render 'icon-bag', custom_width: 25 %}
      </span>
      <div class="ai-header-icon-text-{{ ai_gen_id }}">
        <span class="ai-header-icon-label-{{ ai_gen_id }}">{{ block.settings.cart_text }}</span>
        <span class="ai-header-icon-count-{{ ai_gen_id }}">0 Items</span>
      </div>
    `;
    updateCartCount();
  }
});

observer.observe(document.body, { childList: true, subtree: true });

</script>

<script>
  // --- Sticky Header Scroll Shadow ---
  (function () {
    class StickyHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollThreshold = 50;
      }
      connectedCallback() {
        this.handleScroll = this.handleScroll.bind(this);
        window.addEventListener("scroll", this.handleScroll);
        this.handleScroll();
      }
      disconnectedCallback() {
        window.removeEventListener("scroll", this.handleScroll);
      }
      handleScroll() {
        if (window.scrollY > this.scrollThreshold) {
          this.classList.add("scrolled");
        } else {
          this.classList.remove("scrolled");
        }
      }
    }
    customElements.define("sticky-header-{{ ai_gen_id }}", StickyHeader{{ ai_gen_id }});
  })();
</script>


<script>
  window.SwymCallbacks = window.SwymCallbacks || [];
  window.SwymCallbacks.push(function(swat) {

    function updateWishlistCount() {
      swat.fetch(function(products) {
        var count = products.length;
        var badge = document.querySelector('.ai-header-icon-count-{{ ai_gen_id }} .swym-anchor-badge');
        var label = document.querySelector('.ai-header-icon-count-{{ ai_gen_id }} .swym-wishlist-count-label');

        if (badge) {
          if (count > 0) {
            badge.textContent = count;
            badge.setAttribute("data-count", count);
            badge.style.display = "inline-block";
          } else {
            badge.textContent = "";
            badge.setAttribute("data-count", 0);
            badge.style.display = "none"; // hide badge if 0
          }
        }

        if (label) {
          label.textContent = count === 1 ? "Item" : (count > 1 ? "Items" : "");
        }
      });
    }

    // Run once when page loads
    updateWishlistCount();

    // Re-run every time wishlist changes
    document.addEventListener("swym:collections-update", updateWishlistCount);
    document.addEventListener("swym:product-added", updateWishlistCount);
    document.addEventListener("swym:product-removed", updateWishlistCount);
  });

  function updateCartCount() {
  fetch("/cart.js")
    .then((res) => res.json())
    .then((cart) => {
      document.querySelectorAll(".ai-header-icon-count-{{ ai_gen_id }}").forEach((el) => {
        el.textContent = cart.item_count + (cart.item_count === 1 ? " Item" : " Items");
      });
    });
}

</script>


<script>
