{% doc %}
  @prompt
    A full widht section video with text 
    there should be 2 columns and full cutsomizatiozation option for all like the shopify editor provides, it shpouldnt be only url also provide option for upload video, the button is not being displayed, section top and bottom options are missing and i want to set the hight of the section too, the section should have the section width options too

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-text-section-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    margin: {{ block.settings.section_margin_top }}px 0 {{ block.settings.section_margin_bottom }}px;
    {% if block.settings.section_height != 'auto' %}
      height: {{ block.settings.section_height }}px;
      display: flex;
      align-items: center;
    {% endif %}
  }

  .ai-video-text-container-{{ ai_gen_id }} {
    {% if block.settings.section_width == 'full_width' %}
      width: 100%;
      max-width: none;
      padding: 0 {{ block.settings.full_width_padding }}px;
    {% elsif block.settings.section_width == 'page_width' %}
      max-width: {{ settings.page_width | default: 1200 }}px;
      margin: 0 auto;
      padding: 0 20px;
    {% else %}
      max-width: {{ block.settings.container_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    {% endif %}
    {% if block.settings.section_height != 'auto' %}
      width: 100%;
    {% endif %}
  }

  .ai-video-text-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
    {% if block.settings.section_height != 'auto' %}
      height: 100%;
    {% endif %}
  }

  .ai-video-text-video-column-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.layout == 'text_left' %}
      order: 2;
    {% else %}
      order: 1;
    {% endif %}
  }

  .ai-video-text-content-column-{{ ai_gen_id }} {
    {% if block.settings.layout == 'text_left' %}
      order: 1;
    {% else %}
      order: 2;
    {% endif %}
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-video-text-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.video_aspect_ratio == 'custom' %}
      height: {{ block.settings.video_height }}px;
    {% else %}
      height: 0;
      {% if block.settings.video_aspect_ratio == '16_9' %}
        padding-bottom: 56.25%;
      {% elsif block.settings.video_aspect_ratio == '4_3' %}
        padding-bottom: 75%;
      {% elsif block.settings.video_aspect_ratio == '1_1' %}
        padding-bottom: 100%;
      {% else %}
        padding-bottom: 56.25%;
      {% endif %}
    {% endif %}
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-video-text-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-text-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-text-video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.5;
  }

  .ai-video-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 14px;
    border-radius: 4px;
    text-align: center;
  }

  .ai-video-text-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: 1.2;
  }

  .ai-video-text-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.subheading_margin_bottom }}px;
    line-height: 1.4;
  }

  .ai-video-text-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.text_margin_bottom }}px;
    line-height: 1.6;
  }

  .ai-video-text-button-wrapper-{{ ai_gen_id }} {
    {% if block.settings.text_alignment == 'center' %}
      text-align: center;
    {% elsif block.settings.text_alignment == 'right' %}
      text-align: right;
    {% else %}
      text-align: left;
    {% endif %}
  }

  .ai-video-text-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: {{ block.settings.button_text_weight }};
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-video-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 768px) {
    .ai-video-text-section-{{ ai_gen_id }} {
      {% if block.settings.mobile_section_height != 'auto' %}
        height: {{ block.settings.mobile_section_height }}px;
      {% else %}
        height: auto;
      {% endif %}
      margin: {{ block.settings.mobile_section_margin_top }}px 0 {{ block.settings.mobile_section_margin_bottom }}px;
      padding: {{ block.settings.mobile_section_padding_top }}px 0 {{ block.settings.mobile_section_padding_bottom }}px;
    }

    .ai-video-text-container-{{ ai_gen_id }} {
      {% if block.settings.section_width == 'full_width' %}
        padding: 0 {{ block.settings.mobile_full_width_padding }}px;
      {% else %}
        padding: 0 15px;
      {% endif %}
    }

    .ai-video-text-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-video-text-video-column-{{ ai_gen_id }},
    .ai-video-text-content-column-{{ ai_gen_id }} {
      order: unset;
    }

    {% if block.settings.mobile_layout == 'video_first' %}
      .ai-video-text-video-column-{{ ai_gen_id }} {
        order: 1;
      }
      .ai-video-text-content-column-{{ ai_gen_id }} {
        order: 2;
      }
    {% else %}
      .ai-video-text-content-column-{{ ai_gen_id }} {
        order: 1;
      }
      .ai-video-text-video-column-{{ ai_gen_id }} {
        order: 2;
      }
    {% endif %}

    .ai-video-text-content-column-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_content_padding }}px;
    }

    .ai-video-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-video-text-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheading_size }}px;
    }

    .ai-video-text-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-video-text-video-wrapper-{{ ai_gen_id }} {
      {% if block.settings.video_aspect_ratio == 'custom' %}
        height: {{ block.settings.mobile_video_height }}px;
      {% endif %}
    }
  }
{% endstyle %}

<section
  class="ai-video-text-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-text-container-{{ ai_gen_id }}">
    <div class="ai-video-text-grid-{{ ai_gen_id }}">
      <div class="ai-video-text-video-column-{{ ai_gen_id }}">
        <div class="ai-video-text-video-wrapper-{{ ai_gen_id }}">
          {% if block.settings.video_type == 'upload' and block.settings.video_file != blank %}
            <video
              class="ai-video-text-video-{{ ai_gen_id }}"
              {% if block.settings.autoplay %}autoplay{% endif %}
              {% if block.settings.mute %}muted{% endif %}
              {% if block.settings.loop %}loop{% endif %}
              {% if block.settings.show_controls %}controls{% endif %}
              playsinline
              poster="{% if block.settings.video_poster %}{{ block.settings.video_poster | image_url: width: 1200 }}{% endif %}"
            >
              <source src="{{ block.settings.video_file }}" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          {% elsif block.settings.video_type == 'url' and block.settings.video_url != blank %}
            {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
              {% assign video_id = block.settings.video_url | split: 'v=' | last | split: '&' | first %}
              {% if block.settings.video_url contains 'youtu.be' %}
                {% assign video_id = block.settings.video_url | split: 'youtu.be/' | last | split: '?' | first %}
              {% endif %}
              <iframe
                class="ai-video-text-video-{{ ai_gen_id }}"
                src="https://www.youtube.com/embed/{{ video_id }}?autoplay={% if block.settings.autoplay %}1{% else %}0{% endif %}&mute={% if block.settings.mute %}1{% else %}0{% endif %}&loop={% if block.settings.loop %}1{% else %}0{% endif %}&controls={% if block.settings.show_controls %}1{% else %}0{% endif %}"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {% elsif block.settings.video_url contains 'vimeo.com' %}
              {% assign video_id = block.settings.video_url | split: 'vimeo.com/' | last | split: '?' | first %}
              <iframe
                class="ai-video-text-video-{{ ai_gen_id }}"
                src="https://player.vimeo.com/video/{{ video_id }}?autoplay={% if block.settings.autoplay %}1{% else %}0{% endif %}&muted={% if block.settings.mute %}1{% else %}0{% endif %}&loop={% if block.settings.loop %}1{% else %}0{% endif %}&controls={% if block.settings.show_controls %}1{% else %}0{% endif %}"
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {% else %}
              <video
                class="ai-video-text-video-{{ ai_gen_id }}"
                {% if block.settings.autoplay %}autoplay{% endif %}
                {% if block.settings.mute %}muted{% endif %}
                {% if block.settings.loop %}loop{% endif %}
                {% if block.settings.show_controls %}controls{% endif %}
                playsinline
              >
                <source src="{{ block.settings.video_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            {% endif %}
          {% else %}
            <div class="ai-video-text-video-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-video-text-empty-state-{{ ai_gen_id }}">
                {% if block.settings.video_type == 'upload' %}
                  Upload a video file
                {% else %}
                  Add a video URL
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-video-text-content-column-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-text-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <h3 class="ai-video-text-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </h3>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-video-text-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <div class="ai-video-text-button-wrapper-{{ ai_gen_id }}">
            <a
              href="{{ block.settings.button_url | default: '#' }}"
              class="ai-video-text-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

