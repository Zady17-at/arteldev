{% assign block_st = block.settings %}
{%- if block_st.heading != blank -%}
  <h2 class="{{ block_st.size }} bls_section-heading line-clamp-2 lg:line-clamp-none spacing-bottom" style="--space-bottom: {{ block_st.spacing_bottom }};">{{ block_st.heading }}</h2>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.all.content_setting.heading.label",
  "class": "content-mobile",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "default": "Heading",
      "label": "t:sections.all.content_setting.heading.label"
    },
    {
      "type": "select",
      "id": "size",
      "default": "text-3xl!",
      "label": "t:sections.all.size.label",
      "options": [
        {
          "value": "text-base!",
          "label": "t:sections.all.size.options.text_base.label"
        },
        {
          "value": "text-lg!",
          "label": "t:sections.all.size.options.text_lg.label"
        },
        {
          "value": "text-xl!",
          "label": "t:sections.all.size.options.text_xl.label"
        },
        {
          "value": "text-2xl!",
          "label": "t:sections.all.size.options.text_2xl.label"
        },
        {
          "value": "text-3xl!",
          "label": "t:sections.all.size.options.text_3xl.label"
        },
        {
          "value": "text-4xl!",
          "label": "t:sections.all.size.options.text_4xl.label"
        },
        {
          "value": "text-5xl!",
          "label": "t:sections.all.size.options.text_5xl.label"
        },
        {
          "value": "2xl:text-6xl! text-5xl!",
          "label": "t:sections.all.size.options.text_6xl.label"
        },
        {
          "value": "2xl:text-7xl! lg:text-6xl! text-5xl!",
          "label": "t:sections.all.size.options.text_7xl.label"
        },
        {
          "value": "2xl:text-8xl! lg:text-7xl! text-5xl!",
          "label": "t:sections.all.size.options.text_8xl.label"
        },
        {
          "value": "2xl:text-9xl! lg:text-7xl! text-5xl!",
          "label": "t:sections.all.size.options.text_9xl.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.spacing_bottom",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:sections.all.content_setting.heading.label"
    }
  ]
}
{% endschema %}
