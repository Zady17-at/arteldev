{% doc %}
  @prompt
    create a section with 2 colums img and text and give full customiuzation option in moile and desktop also give option for id as i want to link it on scroll ,

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;background-color: {{ block.settings.background_color }};
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-text-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.gap_desktop }}px;
    align-items: {{ block.settings.vertical_alignment }};
    grid-template-columns: {% if block.settings.layout_desktop == 'image_left' %}1fr 1fr{% else %}1fr 1fr{% endif %};
  }

  {% if block.settings.layout_desktop == 'image_right' %}
    .ai-image-text-grid-{{ ai_gen_id }} .ai-image-text-content-{{ ai_gen_id }} {
      order: 1;
    }
    .ai-image-text-grid-{{ ai_gen_id }} .ai-image-text-image-{{ ai_gen_id }} {
      order: 2;
    }
  {% endif %}

  .ai-image-text-image-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-image-text-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;object-fit: cover;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-image-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .ai-image-text-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    text-align: {{ block.settings.text_alignment_desktop }};
  }

  .ai-image-text-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size_desktop }}px;
    line-height: {{ block.settings.heading_line_height }};
    margin: 0;
  }

  .ai-image-text-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size_desktop }}px;
    line-height: {{ block.settings.text_line_height }};
  }

  .ai-image-text-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_background }};
    align-self: {% if block.settings.text_alignment_desktop == 'center' %}center{% elsif block.settings.text_alignment_desktop == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  .ai-image-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};border-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-image-text-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap_mobile }}px;
      {% if block.settings.layout_mobile == 'image_top' %}
        grid-template-rows: auto auto;
      {% else %}
        grid-template-rows: auto auto;
      {% endif %}
    }

    {% if block.settings.layout_mobile == 'text_top' %}
      .ai-image-text-grid-{{ ai_gen_id }} .ai-image-text-content-{{ ai_gen_id }} {
        order: 1;
      }
      .ai-image-text-grid-{{ ai_gen_id }} .ai-image-text-image-{{ ai_gen_id }} {
        order: 2;
      }
    {% else %}
      .ai-image-text-grid-{{ ai_gen_id }} .ai-image-text-image-{{ ai_gen_id }} {
        order: 1;
      }
      .ai-image-text-grid-{{ ai_gen_id }} .ai-image-text-content-{{ ai_gen_id }} {
        order: 2;
      }
    {% endif %}

    .ai-image-text-content-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_alignment_mobile }};
    }

    .ai-image-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-image-text-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-image-text-button-{{ ai_gen_id }} {
      align-self: {% if block.settings.text_alignment_mobile == 'center' %}center{% elsif block.settings.text_alignment_mobile == 'right' %}flex-end{% else %}flex-start{% endif %};
    }
  }
{% endstyle %}

<section
  class="ai-image-text-section-{{ ai_gen_id }}"
  {% if block.settings.section_id != blank %}id="{{ block.settings.section_id }}"{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="ai-image-text-container-{{ ai_gen_id }}">
    <div class="ai-image-text-grid-{{ ai_gen_id }}">
      <div class="ai-image-text-image-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1200}}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}">
        {% else %}
          <div class="ai-image-text-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-image-text-empty-state-{{ ai_gen_id }}">
              Add an image to get started
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-image-text-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-image-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-image-text-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}

        {% if block.settings.button_text != blank and block.settings.button_url != blank %}
          <a href="{{ block.settings.button_url }}" class="ai-image-text-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

