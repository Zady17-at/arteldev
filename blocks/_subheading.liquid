{% assign block_st = block.settings %}
{%- if block_st.subheading != blank -%}
  <p class="spacing-bottom opacity-70 font-light  {{ block_st.size }}" style="--space-bottom: {{ block_st.spacing_bottom }};">{{ block_st.subheading }}</p>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.all.content_setting.subheading.label",
  "class": "content-mobile",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "default": "Subheading",
      "label": "t:sections.all.content_setting.subheading.label"
    },
    {
      "type": "select",
      "id": "size",
      "default": "lg:text-base text-sm",
      "label": "t:sections.all.size.label",
      "options": [
        {
          "value": "text-xs",
          "label": "t:sections.all.size.options.text_xs.label"
        },
        {
          "value": "text-sm",
          "label": "t:sections.all.size.options.text_sm.label"
        },
        {
          "value": "lg:text-base text-sm",
          "label": "t:sections.all.size.options.text_base.label"
        },
        {
          "value": "lg:text-lg text-base",
          "label": "t:sections.all.size.options.text_lg.label"
        },
        {
          "value": "lg:text-[3.2rem]! md:text-2xl text-xl",
          "label": "t:sections.all.size.options.text_4xl.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.spacing_bottom",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:sections.all.content_setting.subheading.label"
    }
  ]
}
{% endschema %}
