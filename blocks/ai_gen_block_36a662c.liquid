{% doc %}
  @prompt
    A new section with 4 columns each coul shoudl ahve an icon with text the section should have all the customization option of styling like font size color alignment and how much to shoiw in mobile

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-text-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-icon-text-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-icon-text-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
    {% if block.settings.content_alignment == 'center' %}
      text-align: center;
    {% elsif block.settings.content_alignment == 'right' %}
      text-align: right;
    {% else %}
      text-align: left;
    {% endif %}
  }

  .ai-icon-text-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    {% if block.settings.content_alignment == 'center' %}
      align-items: center;
    {% elsif block.settings.content_alignment == 'right' %}
      align-items: flex-end;
    {% else %}
      align-items: flex-start;
    {% endif %}
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-icon-text-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-icon-text-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
  }

  .ai-icon-text-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-icon-text-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin:0 0 {{ block.settings.title_margin_bottom }}px;
    font-weight: {{ block.settings.title_font_weight }};
  }

  .ai-icon-text-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
  }

  .ai-icon-text-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border: 2px dashed #cccccc;
    border-radius: {{ block.settings.icon_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999999;
    font-size: 12px;
    text-align: center;
    padding: 10px;
  }

  @media screen and (max-width: 749px) {
    .ai-icon-text-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-icon-text-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-icon-text-icon-{{ ai_gen_id }} svg {
      width: calc({{ block.settings.mobile_icon_size }}px * 0.6);
      height: calc({{ block.settings.mobile_icon_size }}px * 0.6);
    }

    .ai-icon-text-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_font_size }}px;
    }

    .ai-icon-text-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_font_size }}px;
    }
  }
{% endstyle %}<div class="ai-icon-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-text-container-{{ ai_gen_id }}">
    <div class="ai-icon-text-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign icon_key = 'column_' | append: i | append: '_icon'
          assign title_key = 'column_' | append: i | append: '_title'
          assign description_key = 'column_' | append: i | append: '_description'
          assign column_icon = block.settings[icon_key]
          assign column_title = block.settings[title_key]
          assign column_description = block.settings[description_key]
        %}
        
        <div class="ai-icon-text-column-{{ ai_gen_id }}">
          <div class="ai-icon-text-icon-{{ ai_gen_id }}">
            {% if column_icon != blank %}
              <img
                src="{{ column_icon | image_url: width: 100 }}" 
                alt="{{ column_title | escape }}"
                width="100"
                height="100"loading="lazy"
              >
            {% else %}
              <div class="ai-icon-text-placeholder-{{ ai_gen_id }}">
                Add icon {{ i }}
              </div>
            {% endif %}
          </div>
          
          <div class="ai-icon-text-content-{{ ai_gen_id }}">
            {% if column_title != blank %}
              <h3 class="ai-icon-text-title-{{ ai_gen_id }}">{{ column_title }}</h3>
            {% endif %}
            
            {% if column_description != blank %}
              <div class="ai-icon-text-description-{{ ai_gen_id }}">{{ column_description }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

