{% doc %}
  @prompt
    create a full width section that includes 2 section one for video and one for content and content includes a button too , also the video section should be 900 in height , provide all style customization as it is in provided in shopify edtitir and the section should have option of full width 
    the bvutton should have styling options for customization, vidoe source should be url and source code both, give option for the section layout like right left for video, give upload vidoe option too in source

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-content-section-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.full_width %}
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      max-width: 100vw;
    {% else %}
      max-width: {{ settings.page_width }}px;
      margin: 0 auto;
    {% endif %}
    background-color: {{ block.settings.section_background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-video-content-container-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    min-height: 900px;
    {% if block.settings.layout == 'video_right' %}
      flex-direction: row-reverse;
    {% else %}
      flex-direction: row;
    {% endif %}
    {% if block.settings.full_width %}
      padding: 0;
    {% else %}
      padding: 0 20px;
    {% endif %}
  }

  .ai-video-section-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    height: 900px;
    background-color: {{ block.settings.video_background_color }};
    overflow: hidden;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-video-element-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    color: #ccc;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-content-section-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.content_padding_top }}px {{ block.settings.content_padding_horizontal }}px {{ block.settings.content_padding_bottom }}px;
    background-color: {{ block.settings.content_background_color }};
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-content-wrapper-{{ ai_gen_id }} {
    max-width: 100%;
    width: 100%;
  }

  .ai-content-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    font-weight: {{ block.settings.heading_font_weight }};
    line-height: 1.2;
  }

  .ai-content-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.text_margin_bottom }}px;
  }

  .ai-content-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    text-transform: {{ block.settings.button_text_transform }};
    transition: all 0.3s ease;
    cursor: pointer;
    min-width: {{ block.settings.button_min_width }}px;
  }

  .ai-content-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY({{ block.settings.button_hover_transform }}px);
  }

  @media screen and (max-width: 768px) {
    .ai-video-content-container-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'content_first' %}
        flex-direction: column-reverse;
      {% else %}
        flex-direction: column;
      {% endif %}
    }

    .ai-video-section-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_video_height }}px;
    }

    .ai-content-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_content_padding }}px;
    }

    .ai-content-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-content-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-content-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_font_size }}px;
      padding: {{ block.settings.mobile_button_padding }}px {{ block.settings.mobile_button_padding | times: 1.5 }}px;
    }
  }
{% endstyle %}

<div class="ai-video-content-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-content-container-{{ ai_gen_id }}">
    <div class="ai-video-section-{{ ai_gen_id }}">
      <div class="ai-video-wrapper-{{ ai_gen_id }}">
        {% liquid
          assign has_video = false
          if block.settings.video_upload != blank
            assign video_source = block.settings.video_upload
            assign has_video = true
          elsif block.settings.video_file_url != blank
            assign video_source = block.settings.video_file_url
            assign has_video = true
          elsif block.settings.video_external_url != blank
            assign video_source = block.settings.video_external_url
            assign has_video = true
          endif
        %}

        {% if has_video %}
          <video
            class="ai-video-element-{{ ai_gen_id }}"
            {% if block.settings.video_autoplay %}autoplay{% endif %}
            {% if block.settings.video_muted %}muted{% endif %}
            {% if block.settings.video_loop %}loop{% endif %}
            {% if block.settings.video_controls %}controls{% endif %}
            playsinline
          >
            <source src="{{ video_source }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% else %}
          <div class="ai-video-placeholder-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5,3 19,12 5,21"></polygon>
            </svg>
            <div class="ai-video-empty-state-{{ ai_gen_id }}">
              Upload a video file or add a video URL to get started
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-content-section-{{ ai_gen_id }}">
      <div class="ai-content-wrapper-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-content-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-content-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a
            href="{{ block.settings.button_link | default: '#' }}"
            class="ai-content-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

