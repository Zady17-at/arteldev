    position: relative;
    width: 100vw;
    height: {{ block.settings.desktop_height }}vh;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .ai-slideshow-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-track-{{ ai_gen_id }} {
    display: flex;
    width: 600%;
    height: 100%;
    transition: transform {{ block.settings.transition_speed }}s ease-in-out;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} {
    width: 16.666%;
    height: 100%;
    position: relative;
    display: flex;
