{% doc %}
  @prompt
    create section, which will contain a 3/4 width video on the left side and a title on the right side, text below it, and a button under the text called MORE INFORMATION that will redirect to the page https://artelglass.com/pages/artel-prague-store, add the ability to change the button size, add the ability to change the button width and hight, add the ability to change the position of the title and text, ADD BOLD TEXT OPTION FOR TITLE, ADD THE OPTION TO CHANGE TEXT FOR TITLE, TEXT AND BUTTON, revert the previous change, ADD THE OPTION TO CHANGE TEXT style FOR TITLE and TEXT, ADD THE OPTION TO CHANGE TEXT font FOR TITLE and TEXT, the video will automatically turn on
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-text-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-video-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-text-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: center;
  }

  .ai-video-text-video-column-{{ ai_gen_id }} {
    flex: 0 0 75%;
    max-width: 75%;
  }

  .ai-video-text-content-column-{{ ai_gen_id }} {
    flex: 0 0 25%;
    max-width: 25%;
  }

  .ai-video-text-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    overflow: visible;
    background-color: #f4f4f4;
    min-height: 200px;
  }

  .ai-video-text-video-wrapper-{{ ai_gen_id }} iframe,
  .ai-video-text-video-wrapper-{{ ai_gen_id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .ai-video-text-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-text-video-placeholder-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    opacity: 0.3;
  }

  .ai-video-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-text-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    text-align: {{ block.settings.text_alignment }};
    align-items: {% if block.settings.text_alignment == 'left' %}flex-start{% elsif block.settings.text_alignment == 'center' %}center{% else %}flex-end{% endif %};
  }

  .ai-video-text-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-transform: {{ block.settings.title_transform }};
    font-weight: {% if block.settings.title_bold %}700{% else %}400{% endif %};
    font-style: {% if block.settings.title_italic %}italic{% else %}normal{% endif %};
    text-decoration: {% if block.settings.title_underline %}underline{% else %}none{% endif %};
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
  }

  .ai-video-text-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    font-weight: {% if block.settings.text_bold %}700{% else %}400{% endif %};
    font-style: {% if block.settings.text_italic %}italic{% else %}normal{% endif %};
    text-decoration: {% if block.settings.text_underline %}underline{% else %}none{% endif %};
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
  }

  .ai-video-text-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    text-transform: {{ block.settings.button_text_transform }};
    font-size: {{ block.settings.button_font_size }}px;
    border: 1px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
    text-align: center;
    {% if block.settings.button_width == 'full' %}
      width: 100%;
    {% elsif block.settings.button_width == 'custom' %}
      width: {{ block.settings.button_custom_width }}px;
    {% else %}
      width: auto;
    {% endif %}
    {% if block.settings.button_height == 'custom' %}
      min-height: {{ block.settings.button_custom_height }}px;
    {% endif %}
  }

  .ai-video-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_background_hover }};
    color: {{ block.settings.button_text_color_hover }};
    border-color: {{ block.settings.button_border_color_hover }};
  }

  @media screen and (max-width: 989px) {
    .ai-video-text-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-video-text-video-column-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
      order: 1;
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      height: auto !important;
    }

    .ai-video-text-video-wrapper-{{ ai_gen_id }} {
      display: block !important;
      position: relative !important;
      width: 100% !important;
      padding-bottom: 0 !important;
      min-height: 0 !important;
      height: auto !important;
      background-color: #000 !important;
      overflow: visible !important;
    }

    .ai-video-text-video-wrapper-{{ ai_gen_id }} video {
      display: block !important;
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      height: auto !important;
      aspect-ratio: 16 / 9 !important;
      visibility: visible !important;
      opacity: 1 !important;
      z-index: 10 !important;
      object-fit: cover !important;
    }

    .ai-video-text-content-column-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
      order: 2;
      margin-top: 20px;
      padding-bottom: 40px;
    }

    .ai-video-text-content-{{ ai_gen_id }} {
      gap: calc({{ block.settings.content_gap }}px * 0.6);
    }

    .ai-video-text-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-video-text-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.85);
    }

    .ai-video-text-button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.85);
      padding: calc({{ block.settings.button_padding_vertical }}px * 0.8) calc({{ block.settings.button_padding_horizontal }}px * 0.8);
      {% if block.settings.button_width == 'custom' %}
        width: auto;
        max-width: 100%;
      {% endif %}
      {% if block.settings.button_height == 'custom' %}
        min-height: calc({{ block.settings.button_custom_height }}px * 0.85);
      {% endif %}
    }
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const videoElement = document.getElementById('video-{{ ai_gen_id }}');
    const videoWrapper = document.querySelector('.ai-video-text-video-wrapper-{{ ai_gen_id }}');
    
    if (videoElement) {
      console.log('Video element found:', videoElement);
      console.log('Video source:', videoElement.querySelector('source')?.src);
      
      // Force video attributes
      videoElement.setAttribute('playsinline', 'true');
      videoElement.setAttribute('webkit-playsinline', 'true');
      videoElement.setAttribute('muted', 'true');
      videoElement.setAttribute('autoplay', 'true');
      videoElement.muted = true;
      videoElement.defaultMuted = true;
      
      // Force load the video
      videoElement.load();
      
      // Function to attempt playing the video
      function attemptPlay() {
        console.log('Attempting to play video...');
        videoElement.muted = true;
        
        const playPromise = videoElement.play();
        
        if (playPromise !== undefined) {
          playPromise.then(() => {
            console.log('Video playing successfully');
          }).catch(error => {
            console.log('Autoplay prevented:', error);
            
            // Try to play on user interaction
            const playOnInteraction = function() {
              videoElement.muted = true;
              videoElement.play().then(() => {
                console.log('Video playing after interaction');
              }).catch(err => {
                console.log('Still cannot play:', err);
              });
              document.removeEventListener('touchstart', playOnInteraction);
              document.removeEventListener('click', playOnInteraction);
              document.removeEventListener('scroll', playOnInteraction);
            };
            
            document.addEventListener('touchstart', playOnInteraction, { passive: true });
            document.addEventListener('click', playOnInteraction);
            document.addEventListener('scroll', playOnInteraction, { passive: true });
          });
        }
      }
      
      // Try multiple times to ensure video loads
      setTimeout(() => {
        videoElement.load();
        attemptPlay();
      }, 100);
      
      setTimeout(() => {
        attemptPlay();
      }, 500);
      
      // Also try when video metadata is loaded
      videoElement.addEventListener('loadedmetadata', function() {
        console.log('Video metadata loaded');
        attemptPlay();
      });
      
      videoElement.addEventListener('loadeddata', function() {
        console.log('Video data loaded');
        attemptPlay();
      });
      
      videoElement.addEventListener('canplay', function() {
        console.log('Video can play');
        attemptPlay();
      });
      
      // Use Intersection Observer to play when video is visible
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              console.log('Video is visible');
              attemptPlay();
            }
          });
        }, { threshold: 0.1 });
        
        observer.observe(videoWrapper || videoElement);
      }
    } else {
      console.log('Video element NOT found');
    }
  });
</script>

<div class="ai-video-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-text-container-{{ ai_gen_id }}">
    <div class="ai-video-text-wrapper-{{ ai_gen_id }}">
      <div class="ai-video-text-video-column-{{ ai_gen_id }}">
        <div class="ai-video-text-video-wrapper-{{ ai_gen_id }}">
          {% if block.settings.video_url != blank %}
            {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
              {% assign video_id = block.settings.video_url | split: 'v=' | last | split: '/' | last | split: '&' | first %}
              <iframe
                src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&loop=1&playlist={{ video_id }}&rel=0&modestbranding=1"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {% elsif block.settings.video_url contains 'vimeo.com' %}
              {% assign video_id = block.settings.video_url | split: '/' | last %}
              <iframe
                src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1&muted=1&loop=1&background=1"
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {% else %}
              <video 
                id="video-{{ ai_gen_id }}"
                autoplay 
                muted 
                loop 
                playsinline 
                webkit-playsinline
                preload="metadata"
                style="width:100%;height:100%;object-fit:cover;display:block;"
              >
                <source src="{{ block.settings.video_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            {% endif %}
          {% else %}
            <div class="ai-video-text-video-placeholder-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <div class="ai-video-text-empty-state-{{ ai_gen_id }}">
                Next, add a video URL
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-video-text-content-column-{{ ai_gen_id }}">
        <div class="ai-video-text-content-{{ ai_gen_id }}">
          {% if block.settings.title != blank %}
            <h2 class="ai-video-text-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="ai-video-text-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
          {% endif %}

          <a
            href="https://artelglass.com/pages/artel-prague-store"
            class="ai-video-text-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

