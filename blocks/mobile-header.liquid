{% comment %}
  MOBILE HEADER SECTION
  ---------------------
  - Shows only on mobile (<= 768px)
  - Left: menu toggle (☰)
  - Center: logo
  - Right: search, account, wishlist, cart
  - Uses color + logo settings from Theme Editor
{% endcomment %}

<div class="mobile-header">
  <!-- Left: Toggle -->
  <div class="mobile-header-left">
    <button class="mobile-toggle" aria-label="Toggle menu">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        fill="{{ section.settings.icon_color }}"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>
  
  <!-- Mobile Menu Drawer -->
  <div class="menu-drawer">
    <button class="menu-close" aria-label="Close Menu">✕</button>

    <!-- Render primary menu -->
    {% comment %} primary-menu-testing {% endcomment %}

    <ul class="main-menu list-unstyled m-0" role="list">
      {% assign menu = linklists['primary-menu-testing'] %}
      {% for link in menu.links %}
        <li class="menu-link {% if link.links.size > 0 %}have-child{% endif %}" role="listitem">
          {% if link.links.size > 0 %}
            <div class="menu-item-with-toggle">
              <a href="{{ link.url }}" class="link_text">{{ link.title }}</a>
              <button class="submenu-toggle" aria-label="Toggle Submenu">
                <svg
                  class="arrow"
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>

            <!-- First-level dropdown -->
            <div class="level-1-menu">
              <ul class="menu list-unstyled">
                {% for child in link.links %}
                  <li class="menu-link level-1 {% if child.links.size > 0 %}have-child{% endif %}">
                    {% assign collection_handle = child.object.handle %}
                    {% assign collection_obj = collections[collection_handle] %}
                    {% assign icon_url = collection_obj.metafields.custom.menu_icon | file_url %}
                    <a href="{{ child.url }}" class="submenu__item-text link_text">
                      {% if icon_url %}
                        <img src="{{ icon_url }}" alt="{{ child.title }} icon" class="submenu-icon">
                      {% endif %}
                      <span>{{ child.title }} </span>
                    </a>
                    {% comment %} <a href="{{ child.url }}" class="submenu__item-text link_text">{{ child.title }}</a> {% endcomment %}
                    {% if child.links.size > 0 %}
                      <button class="submenu-toggle" aria-label="Toggle Submenu">
                        <svg
                          class="arrow"
                          width="12"
                          height="12"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </button>

                      <div class="sub-children-menu">
                        <ul>
                          {% for subchild in child.links %}
                            {% assign subcollection_handle = subchild.object.handle %}
                            {% assign subcollection_obj = collections[subcollection_handle] %}
                            {% assign sub_icon_url = subcollection_obj.metafields.custom.menu_icon | file_url %}

                            <li>
                              <a href="{{ subchild.url }}">
                                {% if sub_icon_url %}
                                  <img src="{{ sub_icon_url }}" alt="{{ subchild.title }} icon" class="menu-icon">
                                {% endif %}
                                <span>{{ subchild.title }}</span>
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% else %}
            <a href="{{ link.url }}" class="link_text">{{ link.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>

  <!-- Center: Logo -->
  <div class="mobile-header-center">
    <a href="{{ routes.root_url }}">
      <img src="https://cdn.shopify.com/s/files/1/0929/3447/2054/files/artel_1_no_bg.svg?v=1759997339" alt="Logo">
    </a>
  </div>

  <div class="mobile-header-right">
    <a href="/search" class="mobile-icon-link">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="28"
        height="28"
        fill="none"
        stroke="#fff"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="10.5" cy="10.5" r="7.5"></circle>
        <line x1="21" y1="21" x2="15.8" y2="15.8"></line>
      </svg>
    </a>

    <a href="/account" class="mobile-icon-link">
      <svg
        class="ai-header-icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        stroke-width="1.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
      </svg>
    </a>

    <!-- Wishlist -->
    <a href="/pages/swym-wishlist" class="mobile-icon-link icon-with-bubble">
      <svg
        class="ai-header-icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        stroke-width="1.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
      <span id="mobile-wishlist-count" class="count-bubble">0</span>
    </a>

    <!-- Cart -->
    <a href="{{ routes.cart_url }}" class="mobile-icon-link icon-with-bubble">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="28"
        height="28"
        fill="none"
        stroke="#fff"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5"></path>
        <path d="M3.131 10.507l1.263 12A1.125 1.125 0 005.513 23.75h13.974a1.125 1.125 0 001.119-1.243l-1.264-12A1.125 1.125 0 0118.487 10.5H5.513a1.125 1.125 0 01-1.382 0z"></path>
      </svg>
      <span id="mobile-cart-count" class="count-bubble">{{ cart.item_count }}</span>
    </a>
  </div>
</div>

<!-- CSS -->
<style>
    .icon-with-bubble {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .count-bubble {
      position: absolute;
      top: -9px;
      right: -6px;
      background-color: #C49B37;
      color: #FFF;
      font-size: 9px;
      font-weight: bold;
      border-radius: 50%;
      padding: 2px 5px;
      min-width: 16px;
      height: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      box-shadow: 0 0 2px rgba(0,0,0,0.3);
  }


   .mobile-header { display: none; }

    @media screen and (max-width: 1024px) {

       sticky-header-avzfbszvxdwz2njdvvaigenblock87fb302hf44vm.ai-header-avzfbszvxdwz2njdvvaigenblock87fb302hf44vm {
      display: none;
  }
      .mobile-header {
      background-color: #1e335b;
  }
      .mobile-toggle svg {
      stroke: #fff !important;
  }
     /* Hide desktop header */
      .sticky-header,
      .header,
      header.site-header { display: none !important; }

      .mobile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 15px;
        background-color: {{ section.settings.background_color }};
        border-bottom: 1px solid {{ section.settings.border_color }};
        position: sticky;
        top: 0;
        z-index: 999;
        box-shadow: 0 1px 6px rgba(0,0,0,0.1);
      }

      .mobile-header-left { display: flex; align-items: center; }
      .mobile-header-center { flex: 1; display: flex; justify-content: center; }
      .mobile-header-right { display: flex; align-items: center; gap: 12px; }

      .mobile-toggle {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
      }

      .mobile-toggle svg,
      .mobile-header-right svg {
        width: 22px;
        height: 22px;
        stroke: #fff;
        fill: #1e355b;
      }

      .mobile-header-center img {
        max-height: 35px;
        width: auto;
      }

      .mobile-header-right a {
        color: {{ section.settings.text_color }};
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 14px;
      }

      .mobile-header-count {
        font-size: 11px;
        color: {{ section.settings.count_color }};
        line-height: 1;
      }
      .menu-drawer {
    position: fixed;
    top: 0;
    left: -100%;
    width: 280px;
    height: 100%;
    background: #fff;
    overflow-y: auto;
    box-shadow: 2px 0 8px rgba(0,0,0,0.2);
    transition: left 0.3s ease;
    z-index: 9999;
    padding: 20px;
  }

  .menu-drawer.open {
    left: 0;
  }

  .menu-close {
    background: none;
    border: none;
    font-size: 20px;
    float: right;
    cursor: pointer;
  }

  /* Select 3th menu item directly */
    .menu-drawer .main-menu > li:nth-child(3) .submenu-icon,
    .menu-drawer .main-menu > li:nth-child(3) .menu-icon {
      display: none !important;
  }

    }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const drawer = document.querySelector('.menu-drawer');
    const openBtn = document.querySelector('.mobile-toggle');
    const closeBtn = drawer.querySelector('.menu-close');

    if (openBtn && drawer && closeBtn) {
      openBtn.addEventListener('click', () => drawer.classList.add('open'));
      closeBtn.addEventListener('click', () => drawer.classList.remove('open'));
    }

    // Accordion toggle (mobile only)
    drawer.querySelectorAll('.submenu-toggle').forEach(function (toggle) {
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        const parentLink = this.closest('.menu-link');
        parentLink.classList.toggle('open');
      });
    });
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const drawer = document.querySelector('.menu-drawer');
    const openBtn = document.querySelector('.mobile-toggle');
    const closeBtn = drawer.querySelector('.menu-close');

    if (openBtn && drawer && closeBtn) {
      openBtn.addEventListener('click', () => drawer.classList.add('open'));
      closeBtn.addEventListener('click', () => drawer.classList.remove('open'));
    }

    drawer.querySelectorAll('.submenu-toggle').forEach(function (toggle) {
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        const parent = this.closest('.menu-link');
        parent.classList.toggle('open');
      });
    });
  });
</script>

<script>
  if (window.location.pathname.indexOf('/swym-wishlist') !== -1 && typeof SwymAppLoaded === 'function') {
    SwymAppLoaded();
  }

  function updateWishlistCount() {
    try {
      if (typeof window._swat === 'undefined') {
        console.log('Swym not ready yet');
        return;
      }
      window._swat.fetch(function (products) {
        const count = products.length || 0;
        const countEl = document.getElementById('mobile-wishlist-count');
        if (countEl) countEl.textContent = count;
        console.log('Wishlist count updated:', count);
      });
    } catch (err) {
      console.error('Error updating wishlist count:', err);
    }
  }

  function waitForSwym() {
    if (typeof window._swat !== 'undefined' && typeof window._swat.fetch === 'function') {
      updateWishlistCount();
    } else {
      console.log('Waiting for Swym...');
      setTimeout(waitForSwym, 1000);
    }
  }

  document.addEventListener('swym:ready', updateWishlistCount);

  // Run when wishlist changes
  document.addEventListener('swym:collections-updated', updateWishlistCount);

  // Fallback in case events don’t fire
  document.addEventListener('DOMContentLoaded', waitForSwym);
</script>

