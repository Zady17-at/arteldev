{% doc %}
  @prompt
    Create a custom section with two columns on one row.
    The left column should have a title and a few images up to ten with text labels underneath each image.
    The right column should have a title and also a few images with text labels underneath each image., both sides should be separated, put it back, Both sides should be controlled separately so that it would be possible to turn off one of the sides., SEPARATE THE TITLE AND THE IMAGE WITH A LINE, ADD THE OPTION TO CHANGE LINE STYLE AND COLOR, ADD THE OPTION TO CHANGE THE STYLE AND SIZE OF THE IMAGES, TITLE IN THE CENTER, UP TO 13 PICTURES PER ROW
    , Delete right columm,, after 13 pictures will be another row separate with line like after title, add Divider  after last row, in one row will be 13 pictures , add one more row , add the option to edit images, adjust the image size, add Image fit and Aspect ratio
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-single-column-gallery-{{ ai_gen_id }} {
    padding: 40px 20px;
    max-width: 100%;
  }

  .ai-single-column-gallery__column-{{ ai_gen_id }} {
    max-width: 100%;
  }

  .ai-single-column-gallery__title-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 20px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-single-column-gallery__separator-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    margin-bottom: 30px;
    {% if block.settings.line_style == 'dashed' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.line_color }} 0px,
        {{ block.settings.line_color }} 10px,
        transparent 10px,
        transparent 20px
      );
    {% elsif block.settings.line_style == 'dotted' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.line_color }} 0px,
        {{ block.settings.line_color }} 5px,
        transparent 5px,
        transparent 10px
      );
    {% endif %}
  }

  .ai-single-column-gallery__separator-bottom-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    margin-top: 30px;
    {% if block.settings.line_style == 'dashed' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.line_color }} 0px,
        {{ block.settings.line_color }} 10px,
        transparent 10px,
        transparent 20px
      );
    {% elsif block.settings.line_style == 'dotted' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.line_color }} 0px,
        {{ block.settings.line_color }} 5px,
        transparent 5px,
        transparent 10px
      );
    {% endif %}
  }

  .ai-single-column-gallery__row-separator-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    margin: 30px 0;
    {% if block.settings.line_style == 'dashed' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.line_color }} 0px,
        {{ block.settings.line_color }} 10px,
        transparent 10px,
        transparent 20px
      );
    {% elsif block.settings.line_style == 'dotted' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.line_color }} 0px,
        {{ block.settings.line_color }} 5px,
        transparent 5px,
        transparent 10px
      );
    {% endif %}
  }

  .ai-single-column-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(13, 1fr);
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-single-column-gallery__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-single-column-gallery__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    margin-bottom: 10px;
    overflow: hidden;
    {% if block.settings.image_style == 'circle' %}
      border-radius: 50%;
    {% elsif block.settings.image_style == 'rounded' %}
      border-radius: {{ block.settings.image_border_radius }}px;
    {% endif %}
    {% if block.settings.image_border_enabled %}
      border: {{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }};
    {% endif %}
    {% if block.settings.aspect_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.aspect_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif block.settings.aspect_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% elsif block.settings.aspect_ratio == 'wide' %}
      aspect-ratio: 16 / 9;
    {% endif %}
  }

  .ai-single-column-gallery__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    display: block;
    {% if block.settings.image_grayscale %}
      filter: grayscale(100%);
    {% endif %}
    {% if block.settings.image_hover_effect %}
      transition: transform 0.3s ease, filter 0.3s ease;
    {% endif %}
  }

  {% if block.settings.image_hover_effect %}
    .ai-single-column-gallery__image-wrapper-{{ ai_gen_id }}:hover .ai-single-column-gallery__image-{{ ai_gen_id }} {
      transform: scale({{ block.settings.image_hover_scale }});
      {% if block.settings.image_grayscale %}
        filter: grayscale(0%);
      {% endif %}
    }
  {% endif %}

  .ai-single-column-gallery__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if block.settings.image_style == 'circle' %}
      border-radius: 50%;
    {% elsif block.settings.image_style == 'rounded' %}
      border-radius: {{ block.settings.image_border_radius }}px;
    {% endif %}
  }

  .ai-single-column-gallery__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-single-column-gallery__label-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    word-wrap: break-word;
  }

  @media screen and (max-width: 749px) {
    .ai-single-column-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.images_per_row_mobile }}, 1fr);
    }
  }
{% endstyle %}

<div class="ai-single-column-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-single-column-gallery__column-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-single-column-gallery__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}
    
    <div class="ai-single-column-gallery__separator-{{ ai_gen_id }}"></div>
    
    <div class="ai-single-column-gallery__grid-{{ ai_gen_id }}">
      {% for i in (1..13) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign label_key = 'label_' | append: i
          assign image = block.settings[image_key]
          assign label = block.settings[label_key]
        %}
        
        {% if image != blank or label != blank %}
          <div class="ai-single-column-gallery__item-{{ ai_gen_id }}">
            <div class="ai-single-column-gallery__image-wrapper-{{ ai_gen_id }}">
              {% if image != blank %}
                <img
                  src="{{ image | image_url: width: 500 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="500"
                  height="500"
                  class="ai-single-column-gallery__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-single-column-gallery__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if label != blank %}
              <div class="ai-single-column-gallery__label-{{ ai_gen_id }}">{{ label }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% assign has_second_row = false %}
    {% for i in (14..26) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign label_key = 'label_' | append: i
        assign image = block.settings[image_key]
        assign label = block.settings[label_key]
      %}
      {% if image != blank or label != blank %}
        {% assign has_second_row = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_second_row %}
      <div class="ai-single-column-gallery__row-separator-{{ ai_gen_id }}"></div>
      
      <div class="ai-single-column-gallery__grid-{{ ai_gen_id }}">
        {% for i in (14..26) %}
          {% liquid
            assign image_key = 'image_' | append: i
            assign label_key = 'label_' | append: i
            assign image = block.settings[image_key]
            assign label = block.settings[label_key]
          %}
          
          {% if image != blank or label != blank %}
            <div class="ai-single-column-gallery__item-{{ ai_gen_id }}">
              <div class="ai-single-column-gallery__image-wrapper-{{ ai_gen_id }}">
                {% if image != blank %}
                  <img
                    src="{{ image | image_url: width: 500 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="500"
                    height="500"
                    class="ai-single-column-gallery__image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-single-column-gallery__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              {% if label != blank %}
                <div class="ai-single-column-gallery__label-{{ ai_gen_id }}">{{ label }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% assign has_third_row = false %}
    {% for i in (27..39) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign label_key = 'label_' | append: i
        assign image = block.settings[image_key]
        assign label = block.settings[label_key]
      %}
      {% if image != blank or label != blank %}
        {% assign has_third_row = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_third_row %}
      <div class="ai-single-column-gallery__row-separator-{{ ai_gen_id }}"></div>
      
      <div class="ai-single-column-gallery__grid-{{ ai_gen_id }}">
        {% for i in (27..39) %}
          {% liquid
            assign image_key = 'image_' | append: i
            assign label_key = 'label_' | append: i
            assign image = block.settings[image_key]
            assign label = block.settings[label_key]
          %}
          
          {% if image != blank or label != blank %}
            <div class="ai-single-column-gallery__item-{{ ai_gen_id }}">
              <div class="ai-single-column-gallery__image-wrapper-{{ ai_gen_id }}">
                {% if image != blank %}
                  <img
                    src="{{ image | image_url: width: 500 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="500"
                    height="500"
                    class="ai-single-column-gallery__image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-single-column-gallery__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              {% if label != blank %}
                <div class="ai-single-column-gallery__label-{{ ai_gen_id }}">{{ label }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="ai-single-column-gallery__separator-bottom-{{ ai_gen_id }}"></div>
  </div>
</div>

