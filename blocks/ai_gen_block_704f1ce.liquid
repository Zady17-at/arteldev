{% doc %}
  @prompt
    I need section where I will link PDF catalog which will open in pop up. The section will have Headline, subheadline on the left side. On the right side there will be thumbnail of pdf and after clicking on thumbnail the catalog will get opened.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pdf-catalog-{{ ai_gen_id }} {
    padding: 60px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-pdf-catalog-container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-pdf-catalog-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-pdf-catalog-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-pdf-catalog-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    text-transform: {{ settings.heading_text_transform }};
    letter-spacing: {{ settings.heading_letter_spacing }};
  }

  .ai-pdf-catalog-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  .ai-pdf-catalog-thumbnail-wrapper-{{ ai_gen_id }} {
    position: relative;
    cursor: pointer;
    transition: transform 0.3s ease;
    border-radius: {% if settings.rounded_corner %}{% if settings.rounded_corner_style == 'rounded_corner_large' %}12px{% else %}6px{% endif %}{% else %}0{% endif %};
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-pdf-catalog-thumbnail-wrapper-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .ai-pdf-catalog-thumbnail-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-pdf-catalog-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 3/4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {% if settings.rounded_corner %}{% if settings.rounded_corner_style == 'rounded_corner_large' %}12px{% else %}6px{% endif %}{% else %}0{% endif %};
  }

  .ai-pdf-catalog-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-pdf-catalog-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-pdf-catalog-play-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: {{ block.settings.play_button_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.play_button_icon_color }};
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .ai-pdf-catalog-thumbnail-wrapper-{{ ai_gen_id }}:hover .ai-pdf-catalog-play-icon-{{ ai_gen_id }} {
    transform: translate(-50%, -50%) scale(1.1);
    background-color: {{ block.settings.play_button_hover_color }};
  }

  .ai-pdf-catalog-play-icon-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    margin-left: 3px;
  }

  .ai-pdf-catalog-popup-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    padding: 20px;
  }

  .ai-pdf-catalog-popup-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-pdf-catalog-popup-{{ ai_gen_id }} {
    background-color: white;
    border-radius: 12px;
    width: 100%;
    max-width: 900px;
    max-height: 90vh;
    position: relative;
    overflow: hidden;
    transform: scale(0.8);
    transition: transform 0.3s ease;
  }

  .ai-pdf-catalog-popup-overlay-{{ ai_gen_id }}.active .ai-pdf-catalog-popup-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-pdf-catalog-popup-header-{{ ai_gen_id }} {
    padding: 20px;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ai-pdf-catalog-popup-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    color: #333;
  }

  .ai-pdf-catalog-close-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: background-color 0.3s ease;
    color: #666;
  }

  .ai-pdf-catalog-close-button-{{ ai_gen_id }}:hover {
    background-color: #f5f5f5;
    color: #333;
  }

  .ai-pdf-catalog-popup-content-{{ ai_gen_id }} {
    height: 70vh;
    overflow: hidden;
  }

  .ai-pdf-catalog-iframe-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-pdf-catalog-error-{{ ai_gen_id }} {
    padding: 40px;
    text-align: center;
    color: #666;
  }

  .ai-pdf-catalog-error-icon-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    margin: 0 auto 20px;
    opacity: 0.5;
  }

  @media screen and (max-width: 768px) {
    .ai-pdf-catalog-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    .ai-pdf-catalog-{{ ai_gen_id }} {
      padding: 40px 0;
    }

    .ai-pdf-catalog-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-pdf-catalog-popup-{{ ai_gen_id }} {
      max-width: 95%;
      margin: 10px;
    }

    .ai-pdf-catalog-popup-content-{{ ai_gen_id }} {
      height: 60vh;
    }

    .ai-pdf-catalog-popup-overlay-{{ ai_gen_id }} {
      padding: 10px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-pdf-catalog-popup-header-{{ ai_gen_id }} {
      padding: 15px;
    }

    .ai-pdf-catalog-popup-title-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-pdf-catalog-popup-content-{{ ai_gen_id }} {
      height: 50vh;
    }
  }
{% endstyle %}

<pdf-catalog-{{ ai_gen_id }}
  class="ai-pdf-catalog-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-pdf-catalog-container-{{ ai_gen_id }}">
    <div class="ai-pdf-catalog-content-{{ ai_gen_id }}">
      <div class="ai-pdf-catalog-text-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-pdf-catalog-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        
        {% if block.settings.subheading != blank %}
          <div class="ai-pdf-catalog-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>

      <div class="ai-pdf-catalog-thumbnail-wrapper-{{ ai_gen_id }}" data-pdf-url="{{ block.settings.pdf_file }}">
        {% if block.settings.thumbnail_image %}
          <img
            src="{{ block.settings.thumbnail_image | image_url: width: 600 }}"
            alt="{{ block.settings.thumbnail_image.alt | default: 'PDF Catalog Thumbnail' | escape }}"
            class="ai-pdf-catalog-thumbnail-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.thumbnail_image.width }}"
            height="{{ block.settings.thumbnail_image.height }}"
          >
        {% else %}
          <div class="ai-pdf-catalog-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-pdf-catalog-empty-state-{{ ai_gen_id }}">
              Add a thumbnail image
            </div>
          </div>
        {% endif %}

        <div class="ai-pdf-catalog-play-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="ai-pdf-catalog-popup-overlay-{{ ai_gen_id }}">
    <div class="ai-pdf-catalog-popup-{{ ai_gen_id }}">
      <div class="ai-pdf-catalog-popup-header-{{ ai_gen_id }}">
        <h3 class="ai-pdf-catalog-popup-title-{{ ai_gen_id }}">{{ block.settings.popup_title | default: 'PDF Catalog' }}</h3>
        <button class="ai-pdf-catalog-close-button-{{ ai_gen_id }}" aria-label="Close catalog">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="ai-pdf-catalog-popup-content-{{ ai_gen_id }}">
        {% if block.settings.pdf_file != blank %}
          <iframe
            class="ai-pdf-catalog-iframe-{{ ai_gen_id }}"
            src="{{ block.settings.pdf_file }}"
            title="PDF Catalog Viewer"
          ></iframe>
        {% else %}
          <div class="ai-pdf-catalog-error-{{ ai_gen_id }}">
            <div class="ai-pdf-catalog-error-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14,2 14,8 20,8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10,9 9,9 8,9"></polyline>
              </svg>
            </div>
            <p>Please upload a PDF file to display the catalog.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</pdf-catalog-{{ ai_gen_id }}>

<script>
  (function() {
    class PdfCatalog{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.thumbnail = this.querySelector('.ai-pdf-catalog-thumbnail-wrapper-{{ ai_gen_id }}');
        this.popup = this.querySelector('.ai-pdf-catalog-popup-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-pdf-catalog-close-button-{{ ai_gen_id }}');
        this.iframe = this.querySelector('.ai-pdf-catalog-iframe-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.thumbnail) {
          this.thumbnail.addEventListener('click', () => {
            const pdfUrl = this.thumbnail.dataset.pdfUrl;
            if (pdfUrl) {
              this.openPopup();
            }
          });

          this.thumbnail.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              const pdfUrl = this.thumbnail.dataset.pdfUrl;
              if (pdfUrl) {
                this.openPopup();
              }
            }
          });

          this.thumbnail.setAttribute('tabindex', '0');
          this.thumbnail.setAttribute('role', 'button');
          this.thumbnail.setAttribute('aria-label', 'Open PDF catalog');
        }

        if (this.closeButton) {
          this.closeButton.addEventListener('click', () => {
            this.closePopup();
          });
        }

        if (this.popup) {
          this.popup.addEventListener('click', (e) => {
            if (e.target === this.popup) {
              this.closePopup();
            }
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.popup.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      openPopup() {
        this.popup.classList.add('active');
        document.body.style.overflow = 'hidden';
        
        setTimeout(() => {
          if (this.closeButton) {
            this.closeButton.focus();
          }
        }, 300);
      }

      closePopup() {
        this.popup.classList.remove('active');
        document.body.style.overflow = '';
        
        if (this.thumbnail) {
          this.thumbnail.focus();
        }
      }
    }

    customElements.define('pdf-catalog-{{ ai_gen_id }}', PdfCatalog{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "PDF catalog",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Download Our Catalog"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Explore our complete collection of products in our comprehensive catalog. Click the thumbnail to view the PDF.</p>"
    },
    {
      "type": "text",
      "id": "popup_title",
      "label": "Popup title",
      "default": "Product Catalog"
    },
    {
      "type": "header",
      "content": "PDF file"
    },
    {
      "type": "url",
      "id": "pdf_file",
      "label": "PDF file URL"
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image",
      "label": "Thumbnail image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "play_button_color",
      "label": "Play button color",
      "default": "#564f39"
    },
    {
      "type": "color",
      "id": "play_button_hover_color",
      "label": "Play button hover color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "play_button_icon_color",
      "label": "Play button icon color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "PDF catalog"
    }
  ]
}
{% endschema %}