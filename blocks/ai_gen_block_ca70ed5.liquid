{% doc %}
  @prompt
    Craete a testimonial section 
    main image in center then heading then a carousel tha should have 15 slides , also give the options that how much slides to show on desktop or on mobile in each slide there should be text then a full divider of each slide name and city 
    also give the design option , like color font size extra, the carousle navigation arrrows sould be end to end, The divider should be at at equal for all slides

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-testimonial-main-image-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.spacing_between_elements }}px;
    display: flex;
    justify-content: center;
  }

  .ai-testimonial-main-image-{{ ai_gen_id }} img {
    max-width: {{ block.settings.main_image_width }}px;
    height: auto;
    border-radius: {{ block.settings.main_image_border_radius }}px;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.main_image_width }}px;
    height: 300px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.main_image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-testimonial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    font-style: italic;
  }

  .ai-testimonial-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.spacing_between_elements }}px;
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: {{ block.settings.heading_font_weight }};
  }

  .ai-testimonial-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .ai-testimonial-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    flex: 1;
  }
  .ai-testimonial-carousel-{{ ai_gen_id }} {
  display: flex;
  gap: {{ block.settings.slide_gap }}px;
  transition: transform 0.5s ease;
  will-change: transform;
  box-sizing: border-box;
}

.ai-testimonial-slide-{{ ai_gen_id }} {
  flex: 0 0 auto;
  width: calc((100% - ({{ block.settings.slides_desktop | minus: 1 }} * {{ block.settings.slide_gap }}px)) / {{ block.settings.slides_desktop }});
  background-color: {{ block.settings.slide_background_color }};
  border: {{ block.settings.slide_border_width }}px solid {{ block.settings.slide_border_color }};
  border-radius: {{ block.settings.slide_border_radius }}px;
  padding: {{ block.settings.slide_padding }}px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 250px;
}

@media screen and (max-width: 749px) {
  .ai-testimonial-slide-{{ ai_gen_id }} {
    width: calc((100% - ({{ block.settings.slides_mobile | minus: 1 }} * {{ block.settings.slide_gap }}px)) / {{ block.settings.slides_mobile }});
    min-height: 220px;
  }
}


