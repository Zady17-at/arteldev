{% endstyle %}

<testimonial-carousel-{{ ai_gen_id }}
  class="ai-testimonial-section-{{ ai_gen_id }}"
  data-slides-desktop="{{ block.settings.slides_desktop }}"
  data-slides-mobile="{{ block.settings.slides_mobile }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.main_image %}
    <div class="ai-testimonial-main-image-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.main_image | image_url: width: 800 }}"
        alt="{{ block.settings.main_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.main_image.width }}"
        height="{{ block.settings.main_image.height }}"
      >
    </div>
  {% else %}
    <div class="ai-testimonial-main-image-{{ ai_gen_id }}">
      <div class="ai-testimonial-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-testimonial-empty-state-{{ ai_gen_id }}">
          Add a main image
        </div>
      </div>
    </div>
  {% endif %}

  {% if block.settings.heading != blank %}
    <h2 class="ai-testimonial-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-testimonial-carousel-wrapper-{{ ai_gen_id }}">
    <button class="ai-testimonial-nav-button-{{ ai_gen_id }} ai-testimonial-prev-{{ ai_gen_id }}" aria-label="Previous testimonials">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
    </button>

    <div class="ai-testimonial-carousel-container-{{ ai_gen_id }}">
      <div class="ai-testimonial-carousel-{{ ai_gen_id }}">
        {% for i in (1..15) %}
          {% liquid
            assign testimonial_key = 'testimonial_' | append: i
            assign author_key = 'author_' | append: i
            assign location_key = 'location_' | append: i
            
            assign testimonial_text = block.settings[testimonial_key]
            assign author_name = block.settings[author_key]
            assign location = block.settings[location_key]
          %}

          {% if testimonial_text != blank or author_name != blank %}
            <div class="ai-testimonial-slide-{{ ai_gen_id }}">
              {% if testimonial_text != blank %}
                <div class="ai-testimonial-text-{{ ai_gen_id }}">
                  "{{ testimonial_text }}"
                </div>
              {% endif %}
              
              <div class="ai-testimonial-divider-{{ ai_gen_id }}"></div>
              
              <div class="ai-testimonial-author-info-{{ ai_gen_id }}">
                {% if author_name != blank %}
                  <div class="ai-testimonial-author-{{ ai_gen_id }}">
                    {{ author_name }}
                  </div>
                {% endif %}
                
                {% if location != blank %}
                  <div class="ai-testimonial-location-{{ ai_gen_id }}">
                    {{ location }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <button class="ai-testimonial-nav-button-{{ ai_gen_id }} ai-testimonial-next-{{ ai_gen_id }}" aria-label="Next testimonials">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9,18 15,12 9,6"></polyline>
      </svg>
    </button>
  </div>

  <div class="ai-testimonial-dots-{{ ai_gen_id }}"></div>
</testimonial-carousel-{{ ai_gen_id }}>

<script>
(function() {
  class TestimonialCarousel{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentIndex = 0;
      this.autoplayInterval = null;
    }

    connectedCallback() {
      this.carousel = this.querySelector('.ai-testimonial-carousel-{{ ai_gen_id }}');
      this.slides = this.querySelectorAll('.ai-testimonial-slide-{{ ai_gen_id }}');
      this.prevButton = this.querySelector('.ai-testimonial-prev-{{ ai_gen_id }}');
      this.nextButton = this.querySelector('.ai-testimonial-next-{{ ai_gen_id }}');
      this.dotsContainer = this.querySelector('.ai-testimonial-dots-{{ ai_gen_id }}');
      
      this.slidesDesktop = parseInt(this.dataset.slidesDesktop);
      this.slidesMobile = parseInt(this.dataset.slidesMobile);
      this.autoplay = this.dataset.autoplay === 'true';
      this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

      if (this.slides.length === 0) return;

      this.setupEventListeners();
      this.createDots();
      this.updateCarousel();
      
      if (this.autoplay) {
        this.startAutoplay();
      }

      window.addEventListener('resize', () => this.updateCarousel());
    }

    disconnectedCallback() {
      if (this.autoplayInterval) {
        clearInterval(this.autoplayInterval);
      }
    }

    setupEventListeners() {
      this.prevButton.addEventListener('click', () => this.previousSlide());
      this.nextButton.addEventListener('click', () => this.nextSlide());
      
      this.addEventListener('mouseenter', () => this.stopAutoplay());
      this.addEventListener('mouseleave', () => {
        if (this.autoplay) this.startAutoplay();
      });
    }

    createDots() {
      const slidesToShow = this.getSlidesToShow();
      const totalDots = Math.ceil(this.slides.length / slidesToShow);
      
      this.dotsContainer.innerHTML = '';
      
      for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement('button');
        dot.className = 'ai-testimonial-dot-{{ ai_gen_id }}';
        dot.setAttribute('aria-label', `Go to slide group ${i + 1}`);
        dot.addEventListener('click', () => this.goToSlide(i * slidesToShow));
        this.dotsContainer.appendChild(dot);
      }
    }

    getSlidesToShow() {
      return window.innerWidth <= 749 ? this.slidesMobile : this.slidesDesktop;
    }

    updateCarousel() {
  const slidesToShow = this.getSlidesToShow();
  const maxIndex = Math.max(0, this.slides.length - slidesToShow);

  if (this.currentIndex > maxIndex) {
    this.currentIndex = maxIndex;
  }

  // Get actual pixel-based width (accounts for gaps, padding, etc.)
  const slide = this.slides[0];
  if (!slide) return;

  const slideRect = slide.getBoundingClientRect();
  const carouselRect = this.carousel.getBoundingClientRect();

  // Calculate total slide width including gap
  const computedStyle = window.getComputedStyle(this.carousel);
  const gap = parseFloat(computedStyle.gap) || 0;
  const totalSlideWidth = slideRect.width + gap;

  // Pixel-based transform avoids slide clipping
  const translateX = -(this.currentIndex * totalSlideWidth);
  this.carousel.style.transform = `translateX(${translateX}px)`;

  this.updateNavigation();
  this.updateDots();
}

    updateNavigation() {
      const slidesToShow = this.getSlidesToShow();
      const maxIndex = Math.max(0, this.slides.length - slidesToShow);
      
      this.prevButton.disabled = this.currentIndex === 0;
      this.nextButton.disabled = this.currentIndex >= maxIndex;
    }

    updateDots() {
      const slidesToShow = this.getSlidesToShow();
      const currentDot = Math.floor(this.currentIndex / slidesToShow);
      
      this.querySelectorAll('.ai-testimonial-dot-{{ ai_gen_id }}').forEach((dot, index) => {
        dot.classList.toggle('active', index === currentDot);
      });
    }

    nextSlide() {
      const slidesToShow = this.getSlidesToShow();
      const maxIndex = Math.max(0, this.slides.length - slidesToShow);
      
      if (this.currentIndex < maxIndex) {
        this.currentIndex += slidesToShow;
        if (this.currentIndex > maxIndex) {
          this.currentIndex = maxIndex;
        }
      } else if (this.autoplay) {
        this.currentIndex = 0;
      }
      
      this.updateCarousel();
    }

    previousSlide() {
      const slidesToShow = this.getSlidesToShow();
      
      if (this.currentIndex > 0) {
        this.currentIndex -= slidesToShow;
        if (this.currentIndex < 0) {
          this.currentIndex = 0;
        }
      }
      
      this.updateCarousel();
    }

    goToSlide(index) {
      this.currentIndex = Math.max(0, Math.min(index, this.slides.length - this.getSlidesToShow()));
      this.updateCarousel();
    }

    startAutoplay() {
      if (this.autoplayInterval) {
        clearInterval(this.autoplayInterval);
      }
      
      this.autoplayInterval = setInterval(() => {
        this.nextSlide();
      }, this.autoplaySpeed);
    }

    stopAutoplay() {
      if (this.autoplayInterval) {
        clearInterval(this.autoplayInterval);
        this.autoplayInterval = null;
      }
    }
  }

  customElements.define('testimonial-carousel-{{ ai_gen_id }}', TestimonialCarousel{{ ai_gen_id }});
})();
</script>

