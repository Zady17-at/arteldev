{% doc %}
  @prompt
    create a header that has logo in center on right there are 3 icons of search account and shopping cart with heading of each  or left there is one one image with link, SIGN IN WISHLIDT SHOPPING BAG i need these 3 icons with text in display flex position, Add logo in cenetr and image and link on that image on left 
    also change the icon of sign in with account as it was beofre and show the count of wishlist and shoppingbag, dont add badge on icons for count , simple text under heading, the text and icon should be in display flex, they should be in one row on mobile

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.container_padding }}px;
    background-color: {{ block.settings.background_color }};
    width: 100%;
  }

  .ai-header-left-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    justify-content: flex-start;
  }

  .ai-header-center-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .ai-header-right-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .ai-header-image-link-{{ ai_gen_id }} {
    display: block;
    max-width: {{ block.settings.left_image_width }}px;
  }

  .ai-header-image-link-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-header-image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.left_image_width }}px;
    height: 60px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-header-image-placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    color: #ccc;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    display: block;
    max-width: {{ block.settings.logo_width }}px;
  }

  .ai-header-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-header-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 60px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-size: 18px;
    font-weight: 600;
    color: #666;
  }

  .ai-icon-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
  }

  .ai-icon-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.text_spacing }}px;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    transition: color 0.3s ease;
    padding: {{ block.settings.item_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-icon-item-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    background-color: {{ block.settings.item_hover_background }};
  }

  .ai-icon-item-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-icon-text-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-icon-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    text-transform: {{ block.settings.text_transform }};
    white-space: nowrap;
    text-align: center;
    line-height: 1.2;
  }

  .ai-icon-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.count_text_size }}px;
    font-weight: {{ block.settings.count_text_weight }};
    color: {{ block.settings.count_text_color }};
    margin-top: 2px;
    line-height: 1;
  }

  @media screen and (max-width: 768px) {
    .ai-header-nav-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.8 }}px;
    }

    .ai-header-image-link-{{ ai_gen_id }},
    .ai-header-image-placeholder-{{ ai_gen_id }} {
      max-width: {{ block.settings.left_image_width | times: 0.8 }}px;
    }

    .ai-header-logo-{{ ai_gen_id }},
    .ai-header-logo-placeholder-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width | times: 0.8 }}px;
    }

    .ai-icon-nav-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_spacing | times: 0.6 }}px;
    }

    .ai-icon-item-{{ ai_gen_id }} {
      gap: {{ block.settings.text_spacing | times: 0.6 }}px;
      padding: {{ block.settings.item_padding | times: 0.6 }}px;
    }

    .ai-icon-item-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-icon-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.8 }}px;
    }

    .ai-icon-count-{{ ai_gen_id }} {
      font-size: {{ block.settings.count_text_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-header-nav-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.6 }}px;
    }

    .ai-header-image-link-{{ ai_gen_id }},
    .ai-header-image-placeholder-{{ ai_gen_id }} {
      max-width: {{ block.settings.left_image_width | times: 0.6 }}px;
    }

    .ai-header-logo-{{ ai_gen_id }},
    .ai-header-logo-placeholder-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width | times: 0.6 }}px;
    }

    .ai-icon-nav-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_spacing | times: 0.4 }}px;
    }

    .ai-icon-item-{{ ai_gen_id }} {
      gap: {{ block.settings.text_spacing | times: 0.5 }}px;
      padding: {{ block.settings.item_padding | times: 0.5 }}px;
    }

    .ai-icon-item-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.7 }}px;
      height: {{ block.settings.icon_size | times: 0.7 }}px;
    }

    .ai-icon-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.7 }}px;
    }

    .ai-icon-count-{{ ai_gen_id }} {
      font-size: {{ block.settings.count_text_size | times: 0.7 }}px;
    }

    {% if block.settings.hide_text_mobile %}
      .ai-icon-text-wrapper-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }
{% endstyle %}

<header class="ai-header-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-left-{{ ai_gen_id }}">
    {% if block.settings.left_image %}
      <a href="{{ block.settings.left_image_link | default: '/' }}" class="ai-header-image-link-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.left_image | image_url: width: 200 }}"
          alt="{{ block.settings.left_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.left_image.width }}"
          height="{{ block.settings.left_image.height }}"
        >
      </a>
    {% else %}
      <div class="ai-header-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-header-center-{{ ai_gen_id }}">
    {% if block.settings.logo %}
      <a href="{{ routes.root_url }}" class="ai-header-logo-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name | escape }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      </a>
    {% else %}
      <div class="ai-header-logo-placeholder-{{ ai_gen_id }}">
        {{ shop.name }}
      </div>
    {% endif %}
  </div>

  <div class="ai-header-right-{{ ai_gen_id }}">
    <nav class="ai-icon-nav-{{ ai_gen_id }}">
      <a href="{{ routes.account_login_url }}" class="ai-icon-item-{{ ai_gen_id }}" aria-label="Account">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
        <div class="ai-icon-text-wrapper-{{ ai_gen_id }}">
          <span class="ai-icon-text-{{ ai_gen_id }}">{{ block.settings.signin_text }}</span>
        </div>
      </a>

      <a href="{{ block.settings.wishlist_url | default: '/pages/wishlist' }}" class="ai-icon-item-{{ ai_gen_id }}" aria-label="Wishlist">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
        <div class="ai-icon-text-wrapper-{{ ai_gen_id }}">
          <span class="ai-icon-text-{{ ai_gen_id }}">{{ block.settings.wishlist_text }}</span>
          {% if block.settings.show_wishlist_count %}
            <span class="ai-icon-count-{{ ai_gen_id }}">{{ block.settings.wishlist_count }}</span>
          {% endif %}
        </div>
      </a>

      <a href="{{ routes.cart_url }}" class="ai-icon-item-{{ ai_gen_id }}" aria-label="Shopping bag">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119.993Z" />
        </svg>
        <div class="ai-icon-text-wrapper-{{ ai_gen_id }}">
          <span class="ai-icon-text-{{ ai_gen_id }}">{{ block.settings.shopping_bag_text }}</span>
          {% if block.settings.show_cart_count %}
            <span class="ai-icon-count-{{ ai_gen_id }}">{{ cart.item_count }}</span>
          {% endif %}
        </div>
      </a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header navigation",
  "settings": [
    {
      "type": "header",
      "content": "Left image"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "url",
      "id": "left_image_link",
      "label": "Left image link"
    },
    {
      "type": "range",
      "id": "left_image_width",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Left image width",
      "default": 120
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "header",
      "content": "Text labels"
    },
    {
      "type": "text",
      "id": "signin_text",
      "label": "Sign in text",
      "default": "SIGN IN"
    },
    {
      "type": "text",
      "id": "wishlist_text",
      "label": "Wishlist text",
      "default": "WISHLIST"
    },
    {
      "type": "text",
      "id": "shopping_bag_text",
      "label": "Shopping bag text",
      "default": "SHOPPING BAG"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist URL"
    },
    {
      "type": "header",
      "content": "Count display"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist_count",
      "label": "Show wishlist count",
      "default": true
    },
    {
      "type": "range",
      "id": "wishlist_count",
      "min": 0,
      "max": 99,
      "step": 1,
      "label": "Wishlist count",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_cart_count",
      "label": "Show cart count",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Space between items",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": 5,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Space between icon and text",
      "default": 8
    },
    {
      "type": "range",
      "id": "container_padding",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Container padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Item padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Count text style"
    },
    {
      "type": "range",
      "id": "count_text_size",
      "min": 8,
      "max": 14,
      "step": 1,
      "unit": "px",
      "label": "Count text size",
      "default": 10
    },
    {
      "type": "select",
      "id": "count_text_weight",
      "label": "Count text weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text hover color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "item_hover_background",
      "label": "Item hover background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "count_text_color",
      "label": "Count text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "hide_text_mobile",
      "label": "Hide text on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Header navigation"
    }
  ]
}
{% endschema %}