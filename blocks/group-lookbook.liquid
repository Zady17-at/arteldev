{% liquid
  assign section_st = section.settings
  assign block_st = block.settings
  assign aspect_ratio = section_st.aspect_ratio
  assign ratio = ''
  assign image = block_st.image
  if aspect_ratio != 'adapt'
    assign ratio = ''
    case aspect_ratio
      when 'square'
        assign ratio = '1/1'
      when 'portrait'
        assign ratio = '3/4'
      when 'landscape'
        assign ratio = '4/3'
      else
        assign ratio = '5/2'
    endcase
  else
    if ratio == blank
      if image != blank
        assign ratio = image.aspect_ratio
      else
        assign ratio = '5/2'
      endif
    endif
  endif
%}
<div class="slide-item">
  <div
    class="d-flex relative rounded-base w-full overlay-bg sm:after:hidden {{ block_st.desktop_content_position }} text-{{ block_st.text_alignment }}"
    style="--aspect-ratio: {{ ratio }};"
  >
    <div
      tabindex="-1"
      class="banner__media overflow-hidden will-change-auto! absolute z-2! inset-0{% if block_st.image == blank %} placeholder{% endif %}"
      style="--aspect-ratio: {{ ratio }};"
    >
      <div class="image-picture">
        {%- if block_st.image -%}
          {%- liquid
            assign height = block_st.image.width | divided_by: block_st.image.aspect_ratio | round
            if block_st.image.alt == blank
              assign alt = block_st.heading
            else
              assign alt = block_st.image.alt
            endif
          -%}
          {{
            block_st.image
            | image_url: width: 3840
            | image_tag:
              height: height,
              sizes: '100vw',
              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
              alt: alt,
              loading: 'lazy'
          }}
        {%- else -%}
          {%- render 'placeholder-render', type: 'lifestyle' -%}
        {%- endif -%}
      </div>
    </div>
    <div
      class="lookbook-content flex w-full md:w-auto flex-col md:justify  md:flex-row min-h-600 md:min-h-auto text-{{ block_st.text_alignment }} "
    >
      <div class="lg:p-48 p-30">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.shop_the_look.blocks.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.slideshow.blocks.slide.settings.image.label"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.blocks.slide.settings.all.header.content_settings"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "default": "middle-left",
      "label": "t:sections.all.desktop_content_position.label",
      "info": "t:sections.all.desktop_content_position.info",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.all.desktop_content_position.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.all.desktop_content_position.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.all.desktop_content_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.all.desktop_content_position.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.all.desktop_content_position.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.all.desktop_content_position.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.all.desktop_content_position.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.all.desktop_content_position.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.all.desktop_content_position.options__9.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_alignment.option_1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.option_2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.text_alignment.option_3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.all.text_alignment.label"
    }
  ],
  "blocks": [
    {
      "type": "_heading"
    },
    {
      "type": "_subheading"
    },
    {
      "type": "_description"
    },
    {
      "type": "_product-lookbook"
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop_the_look.blocks.name",
      "blocks": [
        {
          "type": "_heading"
        },
        {
          "type": "_subheading"
        },
        {
          "type": "_product-lookbook"
        }
      ]
    }
  ]
}
{% endschema %}
