{% doc %}
  @prompt
    FUll width section with 2 columns , 1 should have video and other has text  , also their should be full customization options of styling and alignements also for resposnsisve

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-text-section-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.section_background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-video-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding_horizontal }}px;
    display: grid;
    grid-template-columns: {% if block.settings.layout == 'video_left' %}1fr 1fr{% else %}1fr 1fr{% endif %};
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
    min-height: {{ block.settings.min_height }}px;
  }

  {% if block.settings.layout == 'text_left' %}
    .ai-video-text-container-{{ ai_gen_id }} .ai-video-text-video-column-{{ ai_gen_id }} {
      order: 2;
    }
    .ai-video-text-container-{{ ai_gen_id }} .ai-video-text-text-column-{{ ai_gen_id }} {
      order: 1;
    }
  {% endif %}

  .ai-video-text-video-column-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.video_horizontal_alignment }};
    align-items: {{ block.settings.video_vertical_alignment }};
  }

  .ai-video-text-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.video_max_width }}px;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.video_shadow_horizontal }}px {{ block.settings.video_shadow_vertical }}px {{ block.settings.video_shadow_blur }}px {{ block.settings.video_shadow_color }};
  }

  .ai-video-text-video-wrapper-{{ ai_gen_id }} video {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-video-text-video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 300px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-text-video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    color: #999;
  }

  .ai-video-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-text-text-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.text_vertical_alignment }};
    align-items: {{ block.settings.text_horizontal_alignment }};
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.text_padding_vertical }}px {{ block.settings.text_padding_horizontal }}px;
    background-color: {{ block.settings.text_background_color }};
    border-radius: {{ block.settings.text_border_radius }}px;
  }

  .ai-video-text-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    max-width: {{ block.settings.text_max_width }}px;
  }

  .ai-video-text-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
    margin: 0 0 {{ block.settings.text_margin_bottom }}px;
    max-width: {{ block.settings.text_max_width }}px;
  }

  .ai-video-text-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    max-width: {{ block.settings.text_max_width }}px;
  }

  .ai-video-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-video-text-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
      padding: 0 {{ block.settings.mobile_container_padding }}px;
    }

    {% if block.settings.mobile_layout == 'text_first' %}
      .ai-video-text-container-{{ ai_gen_id }} .ai-video-text-video-column-{{ ai_gen_id }} {
        order: 2;
      }
      .ai-video-text-container-{{ ai_gen_id }} .ai-video-text-text-column-{{ ai_gen_id }} {
        order: 1;
      }
    {% else %}
      .ai-video-text-container-{{ ai_gen_id }} .ai-video-text-video-column-{{ ai_gen_id }} {
        order: 1;
      }
      .ai-video-text-container-{{ ai_gen_id }} .ai-video-text-text-column-{{ ai_gen_id }} {
        order: 2;
      }
    {% endif %}

    .ai-video-text-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding_top }}px 0 {{ block.settings.mobile_section_padding_bottom }}px;
    }

    .ai-video-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-video-text-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-video-text-text-column-{{ ai_gen_id }} {
      text-align: {{ block.settings.mobile_text_alignment }};
      padding: {{ block.settings.mobile_text_padding_vertical }}px {{ block.settings.mobile_text_padding_horizontal }}px;
    }

    .ai-video-text-video-column-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_video_alignment }};
    }
  }
{% endstyle %}

<section class="ai-video-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-text-container-{{ ai_gen_id }}">
    <div class="ai-video-text-video-column-{{ ai_gen_id }}">
      <div class="ai-video-text-video-wrapper-{{ ai_gen_id }}">
        {% if block.settings.video %}
          <video
            {% if block.settings.video_autoplay %}autoplay{% endif %}
            {% if block.settings.video_muted %}muted{% endif %}
            {% if block.settings.video_loop %}loop{% endif %}
            {% if block.settings.video_controls %}controls{% endif %}
            {% unless block.settings.video_controls %}playsinline{% endunless %}
            preload="metadata"
          >
            <source src="{{ block.settings.video }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% else %}
          <div class="ai-video-text-video-placeholder-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
            <div class="ai-video-text-empty-state-{{ ai_gen_id }}">
              Add a video to get started
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-video-text-text-column-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-video-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-video-text-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-video-text-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

