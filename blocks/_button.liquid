{% liquid
  assign block_st = block.settings
%}
{% if block_st.first_button_label != blank or block_st.second_button_label != blank %}
  <div class="section-btn d-flex flex-wrap gap-10 spacing-bottom justify-content-{{ section.settings.text_alignment_content }}" style="--space-bottom: {{ block_st.spacing_bottom }};">
    {% if block_st.first_button_label != blank %}
      <a
        {% if block_st.first_button_link == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ block_st.first_button_link | default: "#" }}"
        {% endif %}
        aria-label="{{ block_st.first_button_label }}"
        class="btn remove-underline{% if block_st.first_button_style %} btn-outline{% else %} btn-primary{% endif %}"
      >
        {{ block_st.first_button_label }}
      </a>
    {% endif %}
    {% if block_st.second_button_label != blank %}
      <a
        {% if block_st.second_button_link == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ block_st.second_button_link | default: "#" }}"
        {% endif %}
        aria-label="{{ block_st.second_button_label }}"
        class="btn remove-underline {% if block_st.second_button_style %} btn-outline{% else %} btn-primary{% endif %}"
      >
        {{ block_st.second_button_label }}
      </a>
    {% endif %}
  </div>
{% endif %}
{% schema %}
{
  "name": "t:sections.all.content_setting.button_label.name",
  "settings": [
    {
      "type": "text",
      "id": "first_button_label",
      "default": "Button label",
      "label": "t:sections.all.content_setting.first_button_label.label",
      "info": "t:sections.all.content_setting.button_label.info"
    },
    {
      "type": "url",
      "id": "first_button_link",
      "label": "t:sections.all.content_setting.first_button_label.link"
    },
    {
      "type": "checkbox",
      "id": "first_button_style",
      "label": "t:sections.all.button_style.use_outline_button_style"
    },
    {
      "type": "text",
      "id": "second_button_label",
      "label": "t:sections.all.content_setting.second_button_label.label",
      "info": "t:sections.all.content_setting.button_label.info"
    },
    {
      "type": "url",
      "id": "second_button_link",
      "label": "t:sections.all.content_setting.second_button_label.link"
    },
    {
      "type": "checkbox",
      "id": "second_button_style",
      "label": "t:sections.all.button_style.use_outline_button_style"
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.spacing_bottom",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:sections.all.content_setting.button_label.name"
    }
  ]
}
{% endschema %}
