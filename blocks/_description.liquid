{% assign block_st = block.settings %}
{%- if block_st.description != blank -%}
  <div class="short-des spacing-bottom {{ block_st.size }}" style="--space-bottom: {{ block_st.spacing_bottom }};">{{ block_st.description }}</div>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.all.content_setting.description.label",
  "class": "content-mobile",
  "settings": [
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Description</p>",
      "label": "t:sections.all.content_setting.description.label"
    },
    {
      "type": "select",
      "id": "size",
      "default": "text-base",
      "label": "t:sections.all.size.label",
      "options": [
        {
          "value": "text-xs",
          "label": "t:sections.all.size.options.text_xs.label"
        },
        {
          "value": "text-sm",
          "label": "t:sections.all.size.options.text_sm.label"
        },
        {
          "value": "text-base",
          "label": "t:sections.all.size.options.text_base.label"
        },
        {
          "value": "text-lg",
          "label": "t:sections.all.size.options.text_lg.label"
        },
        {
          "value": "text-xl",
          "label": "t:sections.all.size.options.text_xl.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.spacing_bottom",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:sections.all.content_setting.description.label"
    }
  ]
}
{% endschema %}
