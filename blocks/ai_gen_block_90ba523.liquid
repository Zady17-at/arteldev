{% doc %}
  @prompt
    make a section with  3 columns to add text add divider in each andunder that designation 
    the deivder should be equal for all colums with all the style and customization options, the divider should be full lenght for each coulumn, divider distance option should be adjustable and color option, at the top center of this section add an image and a heading, image should have any border or shadow , just siple whole image that i am addin g, need full image  hsve to add a image witdh 700px, give customization option for adjusitng image width

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-column-text-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-three-column-text__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-three-column-text__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_bottom_margin }}px;
  }

  .ai-three-column-text__image-wrapper-{{ ai_gen_id }} {
    display: inline-block;
    margin-bottom: {{ block.settings.image_bottom_margin }}px;
    width: 100%;
    max-width: {{ block.settings.image_width }}px;
  }

  .ai-three-column-text__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    max-width: {{ block.settings.image_width }}px;
  }

  .ai-three-column-text__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    max-width: {{ block.settings.image_width }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin: 0 auto;
  }

  .ai-three-column-text__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-three-column-text__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: {{ block.settings.heading_line_height }};
    margin: 0;
    text-transform: {{ block.settings.heading_text_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-three-column-text__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    align-items: flex-start;
  }

  .ai-three-column-text__column-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.column_padding }}px;
    background-color: {{ block.settings.column_background_color }};
    border-radius: {{ block.settings.column_border_radius }}px;
  }

  .ai-three-column-text__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
    margin: 0 0 {{ block.settings.text_bottom_margin }}px;
  }

  .ai-three-column-text__divider-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.divider_thickness }}px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_distance_top }}px 0 {{ block.settings.divider_distance_bottom }}px;
    border-radius: {{ block.settings.divider_border_radius }}px;
    {% if block.settings.divider_style == 'gradient' %}
      background: linear-gradient(90deg, {{ block.settings.divider_color }}, {{ block.settings.divider_color_end }});
    {% elsif block.settings.divider_style == 'dashed' %}
      background: none;
      border-top: {{ block.settings.divider_thickness }}px dashed {{ block.settings.divider_color }};
      height: 0;
    {% elsif block.settings.divider_style == 'dotted' %}
      background: none;
      border-top: {{ block.settings.divider_thickness }}px dotted {{ block.settings.divider_color }};
      height: 0;
    {% endif %}
  }

  .ai-three-column-text__designation-{{ ai_gen_id }} {
    color: {{ block.settings.designation_color }};
    font-size: {{ block.settings.designation_size }}px;
    font-weight: {{ block.settings.designation_weight }};
    line-height: {{ block.settings.designation_line_height }};
    margin: 0;
    text-transform: {{ block.settings.designation_text_transform }};
    letter-spacing: {{ block.settings.designation_letter_spacing }}px;
  }

  @media screen and (max-width: 990px) {
    .ai-three-column-text__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-three-column-text__image-wrapper-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_width | times: 0.85 }}px;
    }

    .ai-three-column-text__image-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_width | times: 0.85 }}px;
    }

    .ai-three-column-text__image-placeholder-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_width | times: 0.85 }}px;
      height: {{ block.settings.image_height | times: 0.85 }}px;
    }

    .ai-three-column-text__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-three-column-text__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap | times: 0.7 }}px;
    }

    .ai-three-column-text__column-{{ ai_gen_id }} {
      padding: {{ block.settings.column_padding | times: 0.8 }}px;
    }

    .ai-three-column-text__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-three-column-text__designation-{{ ai_gen_id }} {
      font-size: {{ block.settings.designation_size | times: 0.9 }}px;
    }

    .ai-three-column-text__divider-{{ ai_gen_id }} {
      margin: {{ block.settings.divider_distance_top | times: 0.8 }}px 0 {{ block.settings.divider_distance_bottom | times: 0.8 }}px;
    }

    .ai-three-column-text__image-wrapper-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_width | times: 0.7 }}px;
    }

    .ai-three-column-text__image-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_width | times: 0.7 }}px;
    }

    .ai-three-column-text__image-placeholder-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_width | times: 0.7 }}px;
      height: {{ block.settings.image_height | times: 0.7 }}px;
    }

    .ai-three-column-text__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-three-column-text__header-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.header_bottom_margin | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-three-column-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-column-text__container-{{ ai_gen_id }}">
    <div class="ai-three-column-text__header-{{ ai_gen_id }}">
      {% if block.settings.header_image %}
        <div class="ai-three-column-text__image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.header_image | image_url: width: block.settings.image_width }}"
            alt="{{ block.settings.header_image.alt | escape }}"
            class="ai-three-column-text__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_width }}"
            height="{{ block.settings.header_image.height }}"
          >
        </div>
      {% else %}
        <div class="ai-three-column-text__image-wrapper-{{ ai_gen_id }}">
          <div class="ai-three-column-text__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-three-column-text__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% else %}
        <h2 class="ai-three-column-text__heading-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
          Add your heading here
        </h2>
      {% endif %}
    </div>

    <div class="ai-three-column-text__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign text_key = 'column_' | append: i | append: '_text'
          assign designation_key = 'column_' | append: i | append: '_designation'
          assign column_text = block.settings[text_key]
          assign column_designation = block.settings[designation_key]
        %}
        <div class="ai-three-column-text__column-{{ ai_gen_id }}">
          {% if column_text != blank %}
            <div class="ai-three-column-text__text-{{ ai_gen_id }}">
              {{ column_text }}
            </div>
          {% else %}
            <div class="ai-three-column-text__text-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
              Add your text content here
            </div>
          {% endif %}
          
          <div class="ai-three-column-text__divider-{{ ai_gen_id }}"></div>
          
          {% if column_designation != blank %}
            <div class="ai-three-column-text__designation-{{ ai_gen_id }}">
              {{ column_designation }}
            </div>
          {% else %}
            <div class="ai-three-column-text__designation-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
              Add designation
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

