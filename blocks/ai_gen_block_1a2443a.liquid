{% doc %}
  @prompt
    create a client testimonial section in which there are 15 slides in total but in desktop there should be 3 at a time and 1 in mobile 
    the design should be like 
    main image , then heading 
    then carousel , in each slide there should be review content , divider of each slider and under that client name and under that its city, IT SHOULD GIVE TO SHOW OR HODE NAVIgation and pagination , the divide sould be equal to each slide 
    dont add borders to slides 
    the navigatioon buttons should be on sides for carousel also give the options for mobile responsive slide to show, give the styling option for navigation and pagination, mian image should be in center

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-container-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-testimonials-main-image-{{ ai_gen_id }} {
    margin: 0 auto 40px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-testimonials-main-image-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-testimonials-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    position: relative;
    margin: 0 auto;
    max-width: 500px;
  }

  .ai-testimonials-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 300px;
  }

  .ai-testimonials-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #666;
    font-size: 14px;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 50px;
    font-weight: 600;
    text-align: center;
  }

  .ai-testimonials-carousel-section-{{ ai_gen_id }} {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-testimonials-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-testimonials-carousel-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-testimonials-slide-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 20px);
    background-color: {{ block.settings.slide_background_color }};
    padding: 30px;
    border-radius: {{ block.settings.slide_border_radius }}px;
    text-align: left;
    margin: 0 10px;
    min-height: 250px;
    display: flex;
    flex-direction: column;
  }

  .ai-testimonials-review-content-{{ ai_gen_id }} {
    color: {{ block.settings.review_text_color }};
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .ai-testimonials-divider-{{ ai_gen_id }} {
    width: 100%;
    height: 2px;
    background-color: {{ block.settings.divider_color }};
    margin: 20px 0;
  }

  .ai-testimonials-client-name-{{ ai_gen_id }} {
    color: {{ block.settings.client_name_color }};
    font-size: {{ block.settings.client_name_size }}px;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .ai-testimonials-client-city-{{ ai_gen_id }} {
    color: {{ block.settings.client_city_color }};
    font-size: {{ block.settings.client_city_size }}px;
    margin: 0;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_text_color }};
    border: {{ block.settings.nav_button_border_width }}px solid {{ block.settings.nav_button_border_color }};
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    {% if block.settings.nav_button_style == 'square' %}
      border-radius: {{ block.settings.nav_button_border_radius }}px;
    {% else %}
      border-radius: 50%;
    {% endif %}
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 2;
    {% if block.settings.nav_button_shadow %}
      box-shadow: 0 {{ block.settings.nav_button_shadow_blur }}px {{ block.settings.nav_button_shadow_spread }}px rgba(0, 0, 0, {{ block.settings.nav_button_shadow_opacity }});
    {% endif %}
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    color: {{ block.settings.nav_button_hover_text_color }};
    border-color: {{ block.settings.nav_button_hover_border_color }};
    transform: translateY(-50%) scale({{ block.settings.nav_button_hover_scale }});
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}:disabled {
    opacity: {{ block.settings.nav_button_disabled_opacity }};
    cursor: not-allowed;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}--prev {
    left: {{ block.settings.nav_button_offset }}px;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}--next {
    right: {{ block.settings.nav_button_offset }}px;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }} svg {
    width: {{ block.settings.nav_icon_size }}px;
    height: {{ block.settings.nav_icon_size }}px;
  }

  .ai-testimonials-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: {{ block.settings.dot_spacing }}px;
    margin-top: {{ block.settings.dots_margin_top }}px;
  }

  .ai-testimonials-dots-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-testimonials-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    {% if block.settings.dot_style == 'square' %}
      border-radius: {{ block.settings.dot_border_radius }}px;
    {% else %}
      border-radius: 50%;
    {% endif %}
    background-color: {{ block.settings.dot_inactive_color }};
    border: {{ block.settings.dot_border_width }}px solid {{ block.settings.dot_border_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    {% if block.settings.dot_shadow %}
      box-shadow: 0 {{ block.settings.dot_shadow_blur }}px {{ block.settings.dot_shadow_spread }}px rgba(0, 0, 0, {{ block.settings.dot_shadow_opacity }});
    {% endif %}
  }

  .ai-testimonials-dot-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.dot_hover_color }};
    transform: scale({{ block.settings.dot_hover_scale }});
  }

  .ai-testimonials-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    border-color: {{ block.settings.dot_active_border_color }};
    transform: scale({{ block.settings.dot_active_scale }});
  }

  @media screen and (max-width: 768px) {
    .ai-testimonials-slide-{{ ai_gen_id }} {
      {% if block.settings.mobile_slides_per_view == '1' %}
        flex: 0 0 calc(100% - 20px);
      {% else %}
        flex: 0 0 calc(50% - 15px);
      {% endif %}
      margin: 0 10px;
    }

    .ai-testimonials-container-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      margin-bottom: 30px;
    }

    .ai-testimonials-nav-button-{{ ai_gen_id }} {
      width: {{ block.settings.nav_button_size | times: 0.8 }}px;
      height: {{ block.settings.nav_button_size | times: 0.8 }}px;
    }

    .ai-testimonials-nav-button-{{ ai_gen_id }} svg {
      width: {{ block.settings.nav_icon_size | times: 0.8 }}px;
      height: {{ block.settings.nav_icon_size | times: 0.8 }}px;
    }

    .ai-testimonials-nav-button-{{ ai_gen_id }}--prev {
      left: {{ block.settings.nav_button_offset | times: 0.5 }}px;
    }

    .ai-testimonials-nav-button-{{ ai_gen_id }}--next {
      right: {{ block.settings.nav_button_offset | times: 0.5 }}px;
    }

    .ai-testimonials-dot-{{ ai_gen_id }} {
      width: {{ block.settings.dot_size | times: 0.8 }}px;
      height: {{ block.settings.dot_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-testimonials-slide-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - 20px);
      margin: 0 10px;
    }
  }
{% endstyle %}

<testimonials-carousel-{{ ai_gen_id }}
  class="ai-testimonials-container-{{ ai_gen_id }}"
  data-desktop-slides="{{ block.settings.desktop_slides_per_view }}"
  data-mobile-slides="{{ block.settings.mobile_slides_per_view }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.main_image %}
    <div class="ai-testimonials-main-image-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.main_image | image_url: width: 800 }}"
        alt="{{ block.settings.main_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.main_image.width }}"
        height="{{ block.settings.main_image.height }}"
      >
    </div>
  {% else %}
    <div class="ai-testimonials-main-image-{{ ai_gen_id }}">
      <div class="ai-testimonials-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-testimonials-empty-state-{{ ai_gen_id }}">
          Add a main image
        </div>
      </div>
    </div>
  {% endif %}

  {% if block.settings.heading != blank %}
    <h2 class="ai-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-testimonials-carousel-section-{{ ai_gen_id }}">
    <div class="ai-testimonials-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-testimonials-carousel-{{ ai_gen_id }}" data-carousel>
        {% for i in (1..15) %}
          {% liquid
            assign review_key = 'review_' | append: i
            assign name_key = 'client_name_' | append: i
            assign city_key = 'client_city_' | append: i
            assign review_content = block.settings[review_key]
            assign client_name = block.settings[name_key]
            assign client_city = block.settings[city_key]
          %}

          <div class="ai-testimonials-slide-{{ ai_gen_id }}">
            {% if review_content != blank %}
              <div class="ai-testimonials-review-content-{{ ai_gen_id }}">
                {{ review_content }}
              </div>
            {% else %}
              <div class="ai-testimonials-review-content-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
                Add review content for testimonial {{ i }}
              </div>
            {% endif %}

            <div class="ai-testimonials-divider-{{ ai_gen_id }}"></div>

            {% if client_name != blank %}
              <div class="ai-testimonials-client-name-{{ ai_gen_id }}">{{ client_name }}</div>
            {% else %}
              <div class="ai-testimonials-client-name-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
                Client name {{ i }}
              </div>
            {% endif %}

            {% if client_city != blank %}
              <div class="ai-testimonials-client-city-{{ ai_gen_id }}">{{ client_city }}</div>
            {% else %}
              <div class="ai-testimonials-client-city-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
                City {{ i }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <button
      class="ai-testimonials-nav-button-{{ ai_gen_id }} ai-testimonials-nav-button-{{ ai_gen_id }}--prev {% unless block.settings.show_navigation %}hidden{% endunless %}" 
      data-prev 
      aria-label="Previous testimonials"
    >
      {% if block.settings.nav_icon_type == 'chevron' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15,18 9,12 15,6"></polyline>
        </svg>
      {% else %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12,19 5,12 12,5"></polyline>
        </svg>
      {% endif %}
    </button>
    
    <button 
      class="ai-testimonials-nav-button-{{ ai_gen_id }} ai-testimonials-nav-button-{{ ai_gen_id }}--next {% unless block.settings.show_navigation %}hidden{% endunless %}" 
      data-next 
      aria-label="Next testimonials"
    >
      {% if block.settings.nav_icon_type == 'chevron' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      {% else %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12,5 19,12 12,19"></polyline>
        </svg>
      {% endif %}
    </button>
  </div>

  <div class="ai-testimonials-dots-{{ ai_gen_id }} {% unless block.settings.show_pagination %}hidden{% endunless %}" data-dots></div>
</testimonials-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 15;
      }

      connectedCallback() {
        this.carousel = this.querySelector('[data-carousel]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        
        this.desktopSlidesPerView = parseInt(this.dataset.desktopSlides) || 3;
        this.mobileSlidesPerView = parseInt(this.dataset.mobileSlides) || 1;

        this.updateSlidesPerView();
        this.createDots();
        this.updateCarousel();
        this.setupEventListeners();

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.updateCarousel();
          this.createDots();
        });
      }

      updateSlidesPerView() {
        if (window.innerWidth <= 480) {
          this.slidesPerView = 1;
        } else if (window.innerWidth <= 768) {
          this.slidesPerView = this.mobileSlidesPerView;
        } else {
          this.slidesPerView = this.desktopSlidesPerView;
        }
        
        this.maxSlides = Math.ceil(this.totalSlides / this.slidesPerView);
        
        if (this.currentSlide >= this.maxSlides) {
          this.currentSlide = Math.max(0, this.maxSlides - 1);
        }
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.maxSlides; i++) {
          const dot = document.createElement('button');
          dot.className = `ai-testimonials-dot-{{ ai_gen_id }}${i === this.currentSlide ? ' active' : ''}`;
          dot.setAttribute('aria-label', `Go to slide group ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.previousSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
      }

      updateCarousel() {
        const slideWidth = 100 / this.slidesPerView;
        const translateX = -(this.currentSlide * slideWidth);
        this.carousel.style.transform = `translateX(${translateX}%)`;
        
        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide >= this.maxSlides - 1;

        this.updateDots();
      }

      updateDots() {
        const dots = this.dotsContainer.querySelectorAll('.ai-testimonials-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });
      }

      goToSlide(slideIndex) {
        this.currentSlide = Math.max(0, Math.min(slideIndex, this.maxSlides - 1));
        this.updateCarousel();
      }

      nextSlide() {
        if (this.currentSlide < this.maxSlides - 1) {
          this.currentSlide++;
          this.updateCarousel();
        }
      }

      previousSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateCarousel();
        }
      }
    }

    customElements.define('testimonials-carousel-{{ ai_gen_id }}', TestimonialsCarousel{{ ai_gen_id }});
  })();
</script>

