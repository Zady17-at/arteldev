/* ---------------------- */
/* Base / Reset */
/* ---------------------- */
body { overflow-x: hidden; }
.main-menu, .main-menu ul { list-style: none; margin: 0; padding: 0; }
.main-menu a { display: block; padding: 5px 0; color: #1e35b3; text-decoration: none; }

.level-1-menu {
    background: #f2f2f2 !important;
}

/* ---------------------- */
/* Drawer (Mobile) */
/* ---------------------- */
.menu-drawer {
  position: fixed;
  top: 0; left: -100%;
  width: 320px; 
  height: 100%;
  background: #fff;
  overflow-y: auto;
  box-shadow: 2px 0 8px rgba(0,0,0,0.2);
  transition: left 0.3s ease;
  z-index: 9999;
  padding: 20px;
}
.menu-drawer.open { left: 0; }
.menu-close { background: none; border: none; font-size: 20px; float: right; cursor: pointer; }

/* ---------------------- */
/* Menu Items */
/* ---------------------- */
.menu-link { position: relative; }
.menu-item-with-toggle { display: flex; justify-content: space-between; align-items: center; }
.submenu-toggle { background: none; border: none; cursor: pointer; display: flex; align-items: center; }
.submenu-toggle .arrow { transition: transform 0.3s ease; stroke: #666; }
.menu-link.open > .menu-item-with-toggle > .submenu-toggle .arrow,
.menu-link.open > .submenu-toggle .arrow { transform: rotate(180deg); }

/* ---------------------- */
/* Dropdowns Hidden by Default */
/* ---------------------- */
.level-1-menu, .sub-children-menu { display: none; padding-left: 15px; }
.menu-link.open > .level-1-menu,
.menu-link.open > .sub-children-menu { display: block !important; }

/* ---------------------- */
/* Desktop Mega Menu */
/* ---------------------- */
@media (min-width: 1025px) {
    .level-1-menu {
  transition-delay: 0.1s;
}

.sub-children-menu {
  transition-delay: 0.2s;
}
  
  .sub-children-menu li {
    margin-right: 10rem !important;
}
  .menu-toggle, .menu-close { display: none; }
  .menu-drawer {
    position: static; width: auto; height: auto;
    background: transparent; box-shadow: none; padding: 0; overflow: visible;
  }

  .main-menu { display: flex; justify-content: center; }
  .main-menu > li { display: inline-block; padding: 10px 20px; position: relative; }

