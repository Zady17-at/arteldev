<!-- Container where Swym button will be rendered -->
 <div class="swym-button-bar swym-wishlist-button-bar swym-inject"></div>

<script>
(function() {
  function initSwymButton() {
    // Make sure Swym object exists and the button container is in DOM
    if (typeof Swym !== 'undefined' && document.querySelector('.swym-button-bar')) {
      try {
        // Use Swym’s async API to inject default PDP button
        if (typeof WishlistPlusPDPButtonAPI !== 'undefined') {
          WishlistPlusPDPButtonAPI.injectDefaultButton();
        }
      } catch (err) {
        console.warn('Swym button init error:', err);
      }
    } else {
      // Retry after 100ms if Swym or container is not ready yet
      setTimeout(initSwymButton, 100);
    }
  }

  // Start initialization
  initSwymButton();
})();
</script>

<script>

  document.addEventListener("ConsentmoUserConsentGiven", function() {
  if (typeof Swym === "undefined") {
    var s = document.createElement("script");
    s.src = "https://cdn.swymrelay.com/swym-ext.js";
    s.async = true;
    document.head.appendChild(s);
    console.log("✅ Swym loaded after consent");
  }
});
</script>
<script>
  // Ensure Swym wishlist page initializes on your custom handle
  if (window.location.pathname.indexOf('/swym-wishlist') !== -1 && typeof SwymAppLoaded === 'function') {
    SwymAppLoaded();
    console.log("✅ Swym wishlist page initialized");
  }
</script>

