ng>Buyer<\/strong>\").<\/p><p>Detailed information about ARTĚL is available at<a href=\"https:\/\/www.artelglass.com\/\" target=\"_blank\">www.artelglass.com<\/a>, section \"<a href=\"https:\/\/www.artelglass.com\/about-artel\" target=\"_blank\"><span style=\"text-decoration:underline\">AboutARTĚL<\/span><\/a>\".<br\/><\/p>","description_size":"","description_font":"body_font","remove_space":false}},"spacing_VP8yEp":{"type":"spacing","settings":{"desktop_spacing":15,"mobile_spacing":10}}},"block_order":["heading_qGYtPK","text_xfFW3A","spacing_VP8yEp"],"name":"t:sections.rich-text.presets.name","settings":{"section_width":"stretch_width","color_scheme":"scheme-3198f2fe-3f1b-4a5f-a529-ab4745227037","text_alignment":"left","content_max_width":100,"padding_top":40,"padding_bottom":40}},"rich_text_jRXfEp":{"type":"rich-text","blocks":{"heading_3GaHVd":{"type":"heading","settings":{"heading":"DELIVERY & SHIPPING COSTS","heading_size":"h3","remove_space":false,"remove_letter_spacing":true}},"text_qRypan":{"type":"text","settings":{"text":"<p><strong>•<\/strong> Delivery takes approximately 10 to 12 weeks, earlier delivery may be possible we will inform you when your order is confirmed.<\/p><p><strong>•<\/strong> Delivery of GILDED products takes approximately 12 to 16 weeks, earlier delivery may be possible we will inform you when your order is confirmed.<\/p><p><strong>•<\/strong> We ship worldwide.<\/p>","description_size":"","description_font":"body_font","remove_space":false}},"spacing_AQGMEn":{"type":"spacing","settings":{"desktop_spacing":15,"mobile_spacing":10}}},"block_order":["heading_3GaHVd","text_qRypan","spacing_AQGMEn"],"name":"t:sections.rich-text.presets.name","settings":{"section_width":"stretch_width","color_scheme":"scheme-3198f2fe-3f1b-4a5f-a529-ab4745227037","text_alignment":"left","content_max_width":100,"padding_top":40,"padding_bottom":40}},"rich_text_fqjbVf":{"type":"rich-text","blocks":{"heading_WkBzaE":{"type":"heading","settings":{"heading":"SHIP